// AURI Design System & Theme Tokens
// Inspired by Apple Music & Spotify aesthetics, engineered for performance

export global Theme {
    // Background Surface Colors
    out property <color> bg_app: #090A0D;
    out property <color> bg_sidebar: #0E0F14;
    out property <color> bg_surface: #14151B;
    out property <color> bg_surface_elevated: #1A1C24;
    out property <color> bg_surface_hover: #222430;
    out property <color> bg_card: #15161E;
    out property <color> bg_hud: #0E0F15F0;

    // Borders & Dividers
    out property <color> border_subtle: #1C1E26;
    out property <color> border_elevated: #262936;
    out property <color> border_active: #6366F1;

    // Brand Accents
    out property <color> accent: #6366F1;
    out property <color> accent_hover: #818CF8;
    out property <color> accent_secondary: #EC4899;
    out property <color> accent_glow: #6366F133;

    // Text Hierarchy
    out property <color> text_primary: #FFFFFF;
    out property <color> text_secondary: #9E9EB2;
    out property <color> text_muted: #5D5F70;
    out property <color> text_accent: #A5B4FC;

    // Status & Format Badges
    out property <color> badge_bg: #1E202C;
    out property <color> badge_text: #A5B4FC;
    out property <color> favorite_active: #F43F5E;

    // Radii
    out property <length> radius_sm: 6px;
    out property <length> radius_md: 10px;
    out property <length> radius_lg: 14px;
    out property <length> radius_pill: 999px;
}
