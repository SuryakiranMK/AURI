// AURI Design System & Theme Tokens
// Inspired by Apple Music & Spotify premium aesthetics, optimized for 0% CPU idle.

export global Theme {
    // Background Colors
    out property <color> bg_app: #0C0C0E;
    out property <color> bg_sidebar: #101014;
    out property <color> bg_surface: #16161B;
    out property <color> bg_surface_elevated: #1D1D25;
    out property <color> bg_surface_hover: #252532;
    out property <color> bg_card: #181820;
    out property <color> bg_hud: #0E0E14EE;

    // Borders & Dividers
    out property <color> border_subtle: #22222D;
    out property <color> border_elevated: #2E2E3E;
    out property <color> border_active: #6366F1;

    // Accents
    out property <color> accent: #6366F1;
    out property <color> accent_hover: #818CF8;
    out property <color> accent_secondary: #EC4899;
    out property <color> accent_glow: #6366F133;

    // Text Hierarchy
    out property <color> text_primary: #FFFFFF;
    out property <color> text_secondary: #9E9EB2;
    out property <color> text_muted: #606072;
    out property <color> text_accent: #A5B4FC;

    // Badges & Status
    out property <color> badge_bg: #222232;
    out property <color> badge_text: #A5B4FC;
    out property <color> badge_hi_res: #10B98126;
    out property <color> badge_hi_res_text: #34D399;
    out property <color> favorite_active: #F43F5E;

    // Radii
    out property <length> radius_sm: 6px;
    out property <length> radius_md: 10px;
    out property <length> radius_lg: 16px;
    out property <length> radius_pill: 999px;
}
