// Reusable AURI Widgets
import { Theme } from "theme.slint";

export component AuriIconButton inherits Rectangle {
    in property <image> icon_source;
    in property <string> icon_text: "";
    in property <bool> is_active: false;
    in property <length> icon_size: 16px;
    in property <length> btn_size: 32px;
    in property <color> active_color: Theme.accent;
    in property <color> inactive_color: Theme.text_secondary;
    in property <string> tooltip: "";
    in property <string> shortcut: "";
    callback clicked();

    width: root.btn_size;
    height: root.btn_size;
    border-radius: self.height / 2;
    background: touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if root.icon_text != "": Text {
        text: root.icon_text;
        font_size: root.icon_size;
        color: root.is_active ? root.active_color : (touch.has_hover ? Theme.text_primary : root.inactive_color);
        horizontal_alignment: center;
        vertical_alignment: center;
    }

    if root.icon_text == "": Image {
        source: root.icon_source;
        width: root.icon_size;
        height: root.icon_size;
        image-fit: contain;
        colorize: root.is_active ? root.active_color : (touch.has_hover ? Theme.text_primary : root.inactive_color);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // Tooltip popup
    if root.tooltip != "" && touch.has_hover: Rectangle {
        z: 999;
        y: -24px;
        x: (parent.width - self.width) / 2;
        height: 20px;
        width: tip_layout.preferred_width + 12px;
        background: #181822F5;
        border-width: 1px;
        border-color: #FFFFFF25;
        border-radius: 4px;

        tip_layout := HorizontalLayout {
            padding_left: 6px;
            padding_right: 6px;
            spacing: 4px;
            alignment: center;

            Text {
                text: root.tooltip;
                font_size: 10px;
                font_weight: 600;
                color: #FFFFFF;
                vertical_alignment: center;
            }

            if root.shortcut != "": Text {
                text: "(" + root.shortcut + ")";
                font_size: 9px;
                color: #9E9EB2;
                vertical_alignment: center;
            }
        }
    }
}

export component AuriPlayButton inherits Rectangle {
    in property <bool> is_playing: false;
    in property <length> button_size: 34px;
    in property <color> btn_color: #FFFFFF;
    in property <string> tooltip: "Play / Pause";
    in property <string> shortcut: "Space";
    callback clicked();

    width: root.button_size;
    height: root.button_size;
    border-radius: self.height / 2;
    background: touch.has_hover ? #E2E8F0 : root.btn_color;
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        source: root.is_playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
        width: root.button_size * 0.44;
        height: root.button_size * 0.44;
        image-fit: contain;
        colorize: #000000;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // Tooltip popup
    if root.tooltip != "" && touch.has_hover: Rectangle {
        z: 999;
        y: -24px;
        x: (parent.width - self.width) / 2;
        height: 20px;
        width: tip_layout.preferred_width + 12px;
        background: #181822F5;
        border-width: 1px;
        border-color: #FFFFFF25;
        border-radius: 4px;

        tip_layout := HorizontalLayout {
            padding_left: 6px;
            padding_right: 6px;
            spacing: 4px;
            alignment: center;

            Text {
                text: root.is_playing ? "Pause" : "Play";
                font_size: 10px;
                font_weight: 600;
                color: #FFFFFF;
                vertical_alignment: center;
            }

            if root.shortcut != "": Text {
                text: "(" + root.shortcut + ")";
                font_size: 9px;
                color: #9E9EB2;
                vertical_alignment: center;
            }
        }
    }
}

export component AuriSlider inherits Rectangle {
    in-out property <float> value: 0.35; // 0.0 to 1.0
    callback value_changed(float);

    height: 16px;
    background: Colors.transparent;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: touch.has_hover ? 4px : 3px;
        border-radius: self.height / 2;
        background: #333342;
        animate height { duration: 100ms; }

        fill := Rectangle {
            x: 0;
            width: parent.width * root.value;
            height: parent.height;
            border-radius: self.height / 2;
            background: touch.has_hover ? #FFFFFF : #D1D5DB;
        }

        thumb := Rectangle {
            x: fill.width - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: touch.has_hover ? 10px : 0px;
            height: self.width;
            border-radius: self.height / 2;
            background: #FFFFFF;
            animate width { duration: 100ms; }
        }
    }

    touch := TouchArea {
        pointer_event(event) => {
            if (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed)) {
                root.value = Math.max(0.0, Math.min(1.0, self.mouse_x / self.width));
                root.value_changed(root.value);
            }
        }
    }
}

export component AuriNavButton inherits Rectangle {
    in property <image> icon_source;
    in property <string> icon: "";
    in property <string> icon_text: root.icon;
    in property <string> label: "Item";
    in property <bool> is_selected: false;
    in property <string> badge: "";
    in property <string> tooltip: "";
    callback clicked();

    height: 38px;
    border-radius: Theme.radius_md;
    background: root.is_selected ? Theme.bg_surface_elevated : (touch.has_hover ? Theme.bg_surface : Colors.transparent);
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding_left: 12px;
        padding_right: 12px;
        spacing: 12px;
        alignment: start;

        if root.icon_text != "": Text {
            text: root.icon_text;
            font_size: 15px;
            color: root.is_selected ? Theme.accent_hover : (touch.has_hover ? Theme.text_primary : Theme.text_secondary);
            vertical_alignment: center;
        }

        if root.icon_text == "": Image {
            source: root.icon_source;
            width: 16px;
            height: 16px;
            image-fit: contain;
            colorize: root.is_selected ? Theme.accent_hover : (touch.has_hover ? Theme.text_primary : Theme.text_secondary);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.label;
            font_size: 13px;
            font_weight: root.is_selected ? 600 : 400;
            color: root.is_selected ? Theme.text_primary : (touch.has_hover ? Theme.text_primary : Theme.text_secondary);
            vertical_alignment: center;
            horizontal_stretch: 1;
        }

        if root.badge != "": Rectangle {
            width: badge_text.preferred_width + 12px;
            height: 18px;
            border-radius: 9px;
            background: Theme.badge_bg;
            y: (parent.height - self.height) / 2;

            badge_text := Text {
                text: root.badge;
                font_size: 10px;
                color: Theme.badge_text;
                horizontal_alignment: center;
                vertical_alignment: center;
            }
        }
    }

    // Tooltip popup
    if root.tooltip != "" && touch.has_hover: Rectangle {
        z: 999;
        y: -24px;
        x: 12px;
        height: 20px;
        width: tip_layout.preferred_width + 12px;
        background: #181822F5;
        border-width: 1px;
        border-color: #FFFFFF25;
        border-radius: 4px;

        tip_layout := HorizontalLayout {
            padding_left: 6px;
            padding_right: 6px;
            alignment: center;

            Text {
                text: root.tooltip;
                font_size: 10px;
                font_weight: 600;
                color: #FFFFFF;
                vertical_alignment: center;
            }
        }
    }
}
