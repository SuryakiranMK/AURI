// AURI Gaming Mode Companion HUD (Reference 3 Inspired)
import { Theme } from "theme.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider } from "components.slint";

export component GamingHudView inherits Rectangle {
    in property <bool> is_playing: false;
    in property <string> track_title: "Midnight Drive";
    in property <string> track_artist: "The Cassettes";
    in property <string> track_format: "FLAC 96 KHZ 24-BIT";
    in property <string> track_duration: "3:34";
    in property <string> track_elapsed: "1:18";
    in property <float> track_progress: 0.36;
    in property <float> volume: 0.80;
    in property <bool> is_favorite: true;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in property <bool> show_visualizer: true;

    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_shuffle();
    callback toggle_repeat();
    callback toggle_visualizer();
    callback enter_headless();
    callback switch_to_normal();

    border-radius: Theme.radius_lg;
    background: Theme.bg_hud;
    border-width: 1px;
    border-color: #382D4F;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Navigation & Mode Indicator
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: #10B981;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: "GAMING COMPANION HUD";
                font_size: 10px;
                font_weight: 800;
                letter_spacing: 1px;
                color: #A855F7;
                vertical_alignment: center;
                horizontal_stretch: 1;
            }

            // Enter pure invisible headless mode
            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: #2E1065;

                TouchArea {
                    clicked => { root.enter_headless(); }
                }

                HorizontalLayout {
                    padding_left: 8px;
                    padding_right: 8px;
                    spacing: 4px;
                    Text { text: "👁"; font_size: 9px; vertical_alignment: center; }
                    Text { text: "Hide (0% GPU)"; font_size: 9px; font_weight: 600; color: #E9D5FF; vertical_alignment: center; }
                }
            }

            // Return to normal mode
            AuriIconButton {
                icon_text: "✕";
                icon_size: 10px;
                clicked => { root.switch_to_normal(); }
            }
        }

        // Center Vinyl Cover + High-Res Artwork
        Rectangle {
            height: 140px;
            border-radius: Theme.radius_md;
            background: #181226;
            border-width: 1px;
            border-color: #3B2A56;

            HorizontalLayout {
                padding: 14px;
                spacing: 16px;

                // Vinyl Record Motif
                Rectangle {
                    width: 110px;
                    height: 110px;
                    border-radius: 55px;
                    background: #120D1D;
                    border-width: 3px;
                    border-color: #2D1B4E;

                    // Inner Groove Ring
                    Rectangle {
                        width: 74px;
                        height: 74px;
                        border-radius: 37px;
                        background: #1E1235;
                        border-width: 2px;
                        border-color: #3E246C;

                        // Center Vinyl Label
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: #EC4899;

                            Text {
                                text: "✦";
                                font_size: 16px;
                                color: Theme.text_primary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Track Metadata & Format Badge
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    horizontal_stretch: 1;

                    Text {
                        text: root.track_title;
                        font_size: 18px;
                        font_weight: 800;
                        color: Theme.text_primary;
                        overflow: elide;
                    }

                    Text {
                        text: root.track_artist;
                        font_size: 13px;
                        color: #C084FC;
                        overflow: elide;
                    }

                    // Format Badge (FLAC / OPUS)
                    Rectangle {
                        width: badge_lbl.preferred_width + 12px;
                        height: 20px;
                        border-radius: 4px;
                        background: #3B185F;

                        badge_lbl := Text {
                            text: root.track_format;
                            font_size: 9px;
                            font_weight: 800;
                            letter_spacing: 0.8px;
                            color: #F0ABFC;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }
                }
            }
        }

        // Seekbar with High Visibility Timestamps
        VerticalLayout {
            spacing: 2px;

            AuriSlider {
                value: root.track_progress;
                value_changed(val) => { root.seek(val); }
            }

            HorizontalLayout {
                Text { text: root.track_elapsed; font_size: 10px; color: #D8B4FE; }
                Rectangle { horizontal_stretch: 1; }
                Text { text: root.track_duration; font_size: 10px; color: #D8B4FE; }
            }
        }

        // Primary Controls Row
        HorizontalLayout {
            alignment: center;
            spacing: 20px;

            AuriIconButton {
                icon_text: "⇄";
                is_active: root.is_shuffle;
                active_color: #A855F7;
                clicked => { root.toggle_shuffle(); }
            }
            AuriIconButton {
                icon_text: "⏮";
                clicked => { root.prev_track(); }
            }
            AuriPlayButton {
                is_playing: root.is_playing;
                button_size: 38px;
                btn_color: #9333EA;
                clicked => { root.toggle_play(); }
            }
            AuriIconButton {
                icon_text: "⏭";
                clicked => { root.next_track(); }
            }
            AuriIconButton {
                icon_text: "↻";
                is_active: root.is_repeat;
                active_color: #A855F7;
                clicked => { root.toggle_repeat(); }
            }
        }

        // Volume Row + Spectrum Visualizer Toggle
        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Text {
                text: "🔊";
                font_size: 12px;
                color: #A855F7;
                vertical_alignment: center;
            }

            AuriSlider {
                value: root.volume;
                value_changed(val) => { root.volume_changed(val); }
                width: 140px;
            }

            Rectangle { horizontal_stretch: 1; }

            // Audio Visualizer Waveform Bar Mock
            Rectangle {
                width: 60px;
                height: 18px;
                background: Colors.transparent;

                TouchArea {
                    clicked => { root.toggle_visualizer(); }
                }

                HorizontalLayout {
                    spacing: 3px;
                    alignment: center;

                    Rectangle { width: 3px; height: root.show_visualizer ? 14px : 4px; border-radius: 1px; background: #EC4899; }
                    Rectangle { width: 3px; height: root.show_visualizer ? 8px : 4px; border-radius: 1px; background: #C084FC; }
                    Rectangle { width: 3px; height: root.show_visualizer ? 18px : 4px; border-radius: 1px; background: #A855F7; }
                    Rectangle { width: 3px; height: root.show_visualizer ? 12px : 4px; border-radius: 1px; background: #9333EA; }
                    Rectangle { width: 3px; height: root.show_visualizer ? 6px : 4px; border-radius: 1px; background: #6366F1; }
                }
            }
        }

        // Keyboard Shortcut Footer
        Rectangle {
            height: 20px;
            background: Colors.transparent;

            Text {
                text: "Global Shortcut: Win + Alt + M toggles HUD overlay • Anti-Cheat Safe";
                font_size: 9px;
                color: #7E6B9B;
                horizontal_alignment: center;
                vertical_alignment: center;
            }
        }
    }
}
