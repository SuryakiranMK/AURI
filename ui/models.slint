// AURI Slint Data Models

export struct TrackData {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    format_badge: string,
    is_playing: bool,
    is_favorite: bool,
    color_hue: color,
}

export struct AlbumData {
    id: string,
    title: string,
    artist: string,
    year: string,
    track_count: int,
    color_hue: color,
}

export struct ArtistData {
    name: string,
    role: string,
    color_hue: color,
}
