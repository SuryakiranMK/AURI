// AURI Mini Mode (Floating Controller - Reference 2 Fidelity)
import { Theme } from "theme.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider } from "components.slint";

export component MiniModeView inherits Rectangle {
    in property <int> mini_variant: 0; // 0 = Variant B1 (Card with Art), 1 = Variant B2 (Micro-Pill)
    in property <bool> is_playing: false;
    in property <string> track_title: "Gemini";
    in property <string> track_artist: "Elder";
    in property <string> track_duration: "9:40";
    in property <string> track_elapsed: "2:22";
    in property <float> track_progress: 0.24;
    in property <bool> is_favorite: true;
    in property <bool> always_on_top: true;
    in property <bool> enable_dimming: true;

    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback toggle_favorite();
    callback toggle_always_on_top();
    callback toggle_variant();
    callback switch_to_normal();
    callback switch_to_gaming();

    border-radius: 16px;
    background: #14141AEB; // Glassmorphic translucent dark background
    border-width: 1px;
    border-color: #FFFFFF18; // Subtle 1px glass border
    clip: false;

    // Subtle dimming when idle / unhovered
    opacity: (root.enable_dimming && !hover_area.has_hover) ? 0.88 : 1.0;
    animate opacity { duration: 150ms; }

    hover_area := TouchArea {
        // Keeps hover state active across entire widget
    }

    // ==========================================
    // VARIANT B1: COMPACT CARD WITH ART (Ref 2A)
    // ==========================================
    if root.mini_variant == 0: VerticalLayout {
        padding_top: 8px;
        padding_bottom: 8px;
        padding_left: 12px;
        padding_right: 12px;
        spacing: 4px;

        // Row 1: Artwork + Title/Artist + Floating Controls
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            // Album Artwork (40x40 rounded)
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: #F59E0B;
                clip: true;

                Text {
                    text: "🎵";
                    font_size: 18px;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                }
            }

            // Track Title and Artist
            VerticalLayout {
                horizontal_stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.track_title;
                    font_size: 13px;
                    font_weight: 700;
                    color: #FFFFFF;
                    overflow: elide;
                }

                Text {
                    text: root.track_artist;
                    font_size: 11px;
                    color: #9E9EB2;
                    overflow: elide;
                }
            }

            // Quick Floating Window Controls (fade in on hover)
            HorizontalLayout {
                spacing: 2px;
                alignment: end;
                opacity: hover_area.has_hover ? 1.0 : 0.35;
                animate opacity { duration: 120ms; }

                // Pin toggle (Always on Top)
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/pin.svg");
                    icon_size: 12px;
                    btn_size: 24px;
                    is_active: root.always_on_top;
                    active_color: Theme.accent;
                    tooltip: root.always_on_top ? "Unpin from Top" : "Always on Top";
                    clicked => { root.toggle_always_on_top(); }
                }

                // Switch to Gaming HUD
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/gamepad.svg");
                    icon_size: 12px;
                    btn_size: 24px;
                    tooltip: "Gaming HUD";
                    clicked => { root.switch_to_gaming(); }
                }

                // Expand to Full Normal Mode
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/expand.svg");
                    icon_size: 12px;
                    btn_size: 24px;
                    tooltip: "Expand Window";
                    clicked => { root.switch_to_normal(); }
                }

                // Switch Variant (Micro-Pill)
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/mini.svg");
                    icon_size: 12px;
                    btn_size: 24px;
                    tooltip: "Compact Pill Mode";
                    clicked => { root.toggle_variant(); }
                }
            }
        }

        // Row 2: Seekbar with Elapsed and Total Time
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: root.track_elapsed;
                font_size: 9px;
                color: #7A7A8E;
                vertical_alignment: center;
            }

            AuriSlider {
                value: root.track_progress;
                horizontal_stretch: 1;
                value_changed(val) => { root.seek(val); }
            }

            Text {
                text: root.track_duration;
                font_size: 9px;
                color: #7A7A8E;
                vertical_alignment: center;
            }
        }

        // Row 3: Bottom Centered Transport Controls (Exactly matching Ref 2)
        HorizontalLayout {
            alignment: center;
            spacing: 12px;

            // Heart / Favorite
            AuriIconButton {
                icon_source: root.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                icon_size: 15px;
                btn_size: 28px;
                is_active: root.is_favorite;
                active_color: Theme.favorite_active;
                tooltip: "Favorite";
                clicked => { root.toggle_favorite(); }
            }

            // Previous
            AuriIconButton {
                icon_source: @image-url("../assets/icons/prev.svg");
                icon_size: 15px;
                btn_size: 28px;
                tooltip: "Previous Track";
                shortcut: "Alt+Left";
                clicked => { root.prev_track(); }
            }

            // White Circular Play Button (Central focal point of Ref 2)
            AuriPlayButton {
                is_playing: root.is_playing;
                button_size: 32px;
                tooltip: root.is_playing ? "Pause" : "Play";
                shortcut: "Space";
                clicked => { root.toggle_play(); }
            }

            // Next
            AuriIconButton {
                icon_source: @image-url("../assets/icons/next.svg");
                icon_size: 15px;
                btn_size: 28px;
                tooltip: "Next Track";
                shortcut: "Alt+Right";
                clicked => { root.next_track(); }
            }

            // Mute / Action
            AuriIconButton {
                icon_source: @image-url("../assets/icons/block.svg");
                icon_size: 14px;
                btn_size: 28px;
                tooltip: "Mute / Disable";
                clicked => { /* mute or toggle */ }
            }
        }
    }

    // ==========================================
    // VARIANT B2: ULTRA-THIN MICRO-PILL (Ref 2B)
    // ==========================================
    if root.mini_variant == 1: VerticalLayout {
        padding_top: 4px;
        padding_bottom: 4px;
        padding_left: 10px;
        padding_right: 10px;
        spacing: 2px;

        // Row 1: Seekbar with timestamps and quick switch
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            Text {
                text: root.track_elapsed;
                font_size: 8px;
                color: #7A7A8E;
                vertical_alignment: center;
            }

            AuriSlider {
                value: root.track_progress;
                horizontal_stretch: 1;
                value_changed(val) => { root.seek(val); }
            }

            Text {
                text: root.track_duration;
                font_size: 8px;
                color: #7A7A8E;
                vertical_alignment: center;
            }

            // Variant toggle back to Card
            AuriIconButton {
                icon_source: @image-url("../assets/icons/mini.svg");
                icon_size: 10px;
                btn_size: 18px;
                tooltip: "Expand to Card";
                clicked => { root.toggle_variant(); }
            }
        }

        // Row 2: Streamlined Controls Row
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            // Track Title Snippet
            Text {
                text: root.track_title + " • " + root.track_artist;
                font_size: 11px;
                font_weight: 600;
                color: #FFFFFF;
                overflow: elide;
                horizontal_stretch: 1;
                vertical_alignment: center;
            }

            // Heart
            AuriIconButton {
                icon_source: root.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                icon_size: 13px;
                btn_size: 24px;
                is_active: root.is_favorite;
                active_color: Theme.favorite_active;
                tooltip: "Favorite";
                clicked => { root.toggle_favorite(); }
            }

            // Previous
            AuriIconButton {
                icon_source: @image-url("../assets/icons/prev.svg");
                icon_size: 13px;
                btn_size: 24px;
                tooltip: "Previous Track";
                shortcut: "Alt+Left";
                clicked => { root.prev_track(); }
            }

            // Play/Pause
            AuriPlayButton {
                is_playing: root.is_playing;
                button_size: 26px;
                tooltip: root.is_playing ? "Pause" : "Play";
                shortcut: "Space";
                clicked => { root.toggle_play(); }
            }

            // Next
            AuriIconButton {
                icon_source: @image-url("../assets/icons/next.svg");
                icon_size: 13px;
                btn_size: 24px;
                tooltip: "Next Track";
                shortcut: "Alt+Right";
                clicked => { root.next_track(); }
            }

            // Expand to Normal Mode
            AuriIconButton {
                icon_source: @image-url("../assets/icons/expand.svg");
                icon_size: 11px;
                btn_size: 24px;
                tooltip: "Expand Window";
                clicked => { root.switch_to_normal(); }
            }
        }
    }
}
