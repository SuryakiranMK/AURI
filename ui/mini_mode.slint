// AURI Mini Mode Floating Controller
// Studio-Grade Capsule Architecture (Tide Collapsed + Apple Dynamic Island Aesthetic)

import { Theme } from "theme.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider } from "components.slint";

export component MiniModeView inherits Rectangle {
    in property <bool> is_playing: false;
    in property <string> track_title: "No Track Selected";
    in property <string> track_artist: "Choose any song to play";
    in property <string> track_album: "";
    in property <string> track_duration: "0:00";
    in property <string> track_elapsed: "0:00";
    in property <float> track_progress: 0.0;
    in property <float> volume: 0.80;
    in property <bool> is_favorite: false;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in property <bool> is_pinned: true;
    in property <image> artwork;
    in property <bool> has_artwork: false;

    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_pin();
    callback switch_to_normal();
    callback close_app();
    callback drag_window();

    // Curved Capsule Glassmorphic Background (Tide + Apple Music Capsule)
    background: #0A0C14FA;
    border-radius: 22px;
    border-width: 1.5px;
    border-color: #383B5277;
    clip: true;

    // Draggable Window Trigger Area (Click and drag anywhere on non-interactive spaces)
    drag_area := TouchArea {
        pointer_event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag_window();
            }
        }
    }

    VerticalLayout {
        padding_top: 10px;
        padding_bottom: 10px;
        padding_left: 14px;
        padding_right: 14px;
        spacing: 8px;

        // ====================================================
        // Row 1: Artwork + Track Meta + Transport + Window Actions
        // ====================================================
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            height: 46px;

            // Song Artwork (Rounded 10px with playback accent glow)
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 10px;
                clip: true;
                background: #141624;
                border-width: 1.5px;
                border-color: root.is_playing ? Theme.accent : Theme.border_glass;

                if root.has_artwork : Image {
                    source: root.artwork;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }

                if !root.has_artwork : Rectangle {
                    background: @linear-gradient(135deg, #1E2034 0%, #2A2D48 100%);
                    width: parent.width;
                    height: parent.height;

                    Image {
                        source: @image-url("../assets/icons/music.svg");
                        width: 20px;
                        height: 20px;
                        image-fit: contain;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Track Title & Artist (Left-Aligned, Clean Typography)
            VerticalLayout {
                horizontal_stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.track_title;
                    font_size: 13px;
                    font_weight: 700;
                    color: #FFFFFF;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: root.track_artist;
                        font_size: 11px;
                        font_weight: 500;
                        color: Theme.text_secondary;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 48px;
                        height: 15px;
                        border-radius: 3px;
                        background: Theme.badge_bg;
                        border-width: 1px;
                        border-color: Theme.badge_border;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "Opus 160k";
                            font_size: 8px;
                            font_weight: 700;
                            color: Theme.badge_text;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }
                }
            }

            // Transport Controls (Prev, Play/Pause 30px, Next)
            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/prev.svg");
                    icon_size: 14px;
                    btn_size: 26px;
                    tooltip: "Previous";
                    clicked => { root.prev_track(); }
                }

                AuriPlayButton {
                    button_size: 30px;
                    is_playing: root.is_playing;
                    clicked => { root.toggle_play(); }
                }

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/next.svg");
                    icon_size: 14px;
                    btn_size: 26px;
                    tooltip: "Next";
                    clicked => { root.next_track(); }
                }
            }

            // Quick Window & State Actions
            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                // Favorite Heart
                AuriIconButton {
                    icon_source: root.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                    icon_size: 13px;
                    btn_size: 26px;
                    is_active: root.is_favorite;
                    active_color: Theme.favorite_active;
                    tooltip: "Favorite";
                    clicked => { root.toggle_favorite(); }
                }

                // Pin Always-on-Top Toggle
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/pin.svg");
                    icon_size: 13px;
                    btn_size: 26px;
                    is_active: root.is_pinned;
                    active_color: Theme.accent;
                    tooltip: root.is_pinned ? "Unpin from Top" : "Pin Above Games";
                    clicked => { root.toggle_pin(); }
                }

                // Restore Normal Mode
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/expand.svg");
                    icon_size: 13px;
                    btn_size: 26px;
                    tooltip: "Restore Full Player";
                    clicked => { root.switch_to_normal(); }
                }

                // Close / Minimize
                AuriIconButton {
                    icon_source: @image-url("../assets/icons/close.svg");
                    icon_size: 11px;
                    btn_size: 26px;
                    tooltip: "Close Mini Mode";
                    clicked => { root.close_app(); }
                }
            }
        }

        // ====================================================
        // Row 2: Progress Seekbar + Working Volume Slider & Percent
        // ====================================================
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            height: 26px;

            // Seekbar with Elapsed and Total Duration
            HorizontalLayout {
                horizontal_stretch: 1;
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.track_elapsed;
                    font_size: 9px;
                    font_weight: 600;
                    color: Theme.text_muted;
                    vertical_alignment: center;
                }

                AuriSlider {
                    horizontal_stretch: 1;
                    height: 24px;
                    value: root.track_progress;
                    value_changed(val) => { root.seek(val); }
                }

                Text {
                    text: root.track_duration;
                    font_size: 9px;
                    font_weight: 600;
                    color: Theme.text_muted;
                    vertical_alignment: center;
                }
            }

            // Divider Dot
            Rectangle {
                width: 3px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.text_muted;
                y: (parent.height - self.height) / 2;
            }

            // Mini Mode Volume Slider & Mute Toggle
            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                AuriIconButton {
                    icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                    icon_size: 14px;
                    btn_size: 24px;
                    y: (parent.height - self.height) / 2;
                    tooltip: root.volume == 0.0 ? "Unmute" : "Mute";
                    clicked => {
                        root.volume_changed(root.volume > 0.0 ? 0.0 : 0.8);
                    }
                }

                AuriSlider {
                    width: 70px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    value: root.volume;
                    value_changed(val) => { root.volume_changed(val); }
                }

                Text {
                    text: Math.round(root.volume * 100) + "%";
                    font_size: 9px;
                    font_weight: 600;
                    color: Theme.text_muted;
                    width: 26px;
                    horizontal_alignment: right;
                    vertical_alignment: center;
                }
            }
        }
    }
}
