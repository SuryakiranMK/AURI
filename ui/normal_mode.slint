// AURI Normal Mode View (Apple-Grade Precision Table Alignment & Glassmorphism)
import { Theme } from "theme.slint";
import { TrackData, AlbumData, ArtistData } from "models.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider, AuriNavButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component NormalModeView inherits Rectangle {
    in property <string> current_nav: "home";
    in property <bool> is_playing: false;
    in property <string> track_title: "Midnight Drive";
    in property <string> track_artist: "The Cassettes";
    in property <string> track_album: "Synthwave Dreams";
    in property <string> track_duration: "3:34";
    in property <string> track_elapsed: "1:18";
    in property <float> track_progress: 0.36;
    in property <float> volume: 0.80;
    in property <bool> is_favorite: true;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in property <string> audio_engine_name: "Native WASAPI";
    in property <string> ram_usage: "28.5 MB";
    in-out property <string> search_query: "";
    in-out property <string> local_music_path: "C:\\Users\\user\\Music";
    in property <bool> loudness_norm_enabled: true;
    in property <image> artwork;
    in property <bool> has_artwork: false;

    // Collections
    in-out property <[TrackData]> search_results: [];
    in-out property <[TrackData]> queue_tracks: [];
    in-out property <[TrackData]> home_tracks: [];
    in-out property <[AlbumData]> home_albums: [];
    in-out property <[TrackData]> local_tracks: [];
    in-out property <[TrackData]> favorite_tracks: [];
    in-out property <[AlbumData]> all_albums: [];
    in-out property <[ArtistData]> similar_artists: [];

    // Callbacks
    callback navigate(string);
    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_track_favorite(string);
    callback toggle_shuffle();
    callback toggle_repeat();
    callback switch_to_mini();
    callback switch_to_gaming();
    callback trim_ram();
    callback perform_search(string);
    callback play_track(string, string, string, int);
    callback switch_audio_engine(int);
    callback rescan_local(string);
    callback play_album(string);
    callback toggle_loudness(bool);

    background: Theme.bg_app;

    HorizontalLayout {
        // ==========================================
        // 1. LEFT SIDEBAR: STREAMLINED GLASS NAVIGATION
        // ==========================================
        Rectangle {
            width: 210px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_glass;

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // Brand Header (AURI)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/brand_64.png");
                        width: 28px;
                        height: 28px;
                        image-fit: contain;
                    }

                    Text {
                        text: "AURI";
                        font_size: 17px;
                        font_weight: 800;
                        letter_spacing: 1.2px;
                        color: #FFFFFF;
                        vertical_alignment: center;
                    }

                    Rectangle {
                        width: 48px;
                        height: 18px;
                        border-radius: Theme.radius_pill;
                        background: Theme.badge_bg;
                        border-width: 1px;
                        border-color: Theme.badge_border;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "v0.2.2";
                            font_size: 9px;
                            font_weight: 700;
                            color: Theme.badge_text;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }
                }

                // Navigation Menu
                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "LIBRARY";
                        font_size: 10px;
                        font_weight: 800;
                        letter_spacing: 1px;
                        color: Theme.text_muted;
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/music.svg");
                        label: "Home";
                        is_selected: root.current_nav == "home";
                        tooltip: "Featured & Quick Picks";
                        clicked => { root.navigate("home"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/search.svg");
                        label: "Search";
                        is_selected: root.current_nav == "search";
                        tooltip: "Search YouTube Music Catalog";
                        clicked => { root.navigate("search"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/album.svg");
                        label: "Albums";
                        is_selected: root.current_nav == "albums";
                        tooltip: "Albums Collection";
                        clicked => { root.navigate("albums"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/folder.svg");
                        label: "Local Files";
                        is_selected: root.current_nav == "local";
                        tooltip: "Local Audio Files";
                        clicked => { root.navigate("local"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/heart.svg");
                        label: "Favorites";
                        is_selected: root.current_nav == "favorites";
                        tooltip: "Starred Songs";
                        clicked => { root.navigate("favorites"); }
                    }
                }

                // Spacer
                Rectangle { vertical_stretch: 1; }

                // Live RAM Working Set & Purge Card
                Rectangle {
                    height: 64px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_glass;
                    border-width: 1px;
                    border-color: Theme.border_glass;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            Text {
                                text: "WORKING SET (RAM)";
                                font_size: 9px;
                                font_weight: 800;
                                letter_spacing: 0.6px;
                                color: Theme.text_muted;
                                horizontal_stretch: 1;
                            }
                            Text {
                                text: root.ram_usage;
                                font_size: 11px;
                                font_weight: 800;
                                color: Theme.success;
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 6px;
                            background: trim_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated;
                            border-width: 1px;
                            border-color: Theme.border_glass;

                            trim_touch := TouchArea {
                                clicked => { root.trim_ram(); }
                            }

                            Text {
                                text: "Purge Working Set";
                                font_size: 10px;
                                font_weight: 600;
                                color: Theme.text_secondary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Settings Navigation Button
                AuriNavButton {
                    icon_source: @image-url("../assets/icons/settings.svg");
                    label: "Settings";
                    is_selected: root.current_nav == "settings";
                    tooltip: "Audio Engine & Preferences";
                    clicked => { root.navigate("settings"); }
                }
            }
        }

        // ==========================================
        // 2. CENTER CONTENT VIEWPORT (WIDE & SPACIOUS)
        // ==========================================
        Rectangle {
            horizontal_stretch: 1;
            background: Theme.bg_app;

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // ------------------------------------------
                // TOP BAR: GENEROUS SEARCH PILL + ENGINE BADGE + VOLUME + MODE SWITCHERS
                // ------------------------------------------
                HorizontalLayout {
                    spacing: 14px;
                    height: 40px;

                    // Wide Apple Glass Search Pill
                    Rectangle {
                        min_width: 320px;
                        horizontal_stretch: 1;
                        height: 40px;
                        border-radius: Theme.radius_pill;
                        background: Theme.bg_surface_glass;
                        border-width: 1px;
                        border-color: search_input.has_focus ? Theme.accent : Theme.border_glass;
                        animate border-color { duration: 120ms; }

                        TouchArea {
                            clicked => { search_input.focus(); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 10px;

                            Image {
                                source: @image-url("../assets/icons/search.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: search_input.has_focus ? Theme.accent : Theme.text_muted;
                                y: (parent.height - self.height) / 2;
                            }

                            Rectangle {
                                horizontal_stretch: 1;

                                if search_input.text == "": Text {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text: "Search songs, albums, artists (press Enter)...";
                                    font_size: 13px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }

                                search_input := TextInput {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.search_query;
                                    font_size: 13px;
                                    color: Theme.text_primary;
                                    vertical_alignment: center;
                                    accepted => {
                                        root.navigate("search");
                                        root.perform_search(self.text);
                                    }
                                }
                            }

                            if search_input.text != "": AuriIconButton {
                                icon_source: @image-url("../assets/icons/close.svg");
                                icon_size: 14px;
                                btn_size: 26px;
                                tooltip: "Clear Search";
                                clicked => {
                                    search_input.text = "";
                                    root.perform_search("");
                                }
                            }
                        }
                    }

                    // Active Audio Engine Glass Badge
                    Rectangle {
                        height: 30px;
                        border-radius: Theme.radius_pill;
                        background: Theme.bg_surface_glass;
                        border-width: 1px;
                        border-color: Theme.border_glass;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.success;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.audio_engine_name;
                                font_size: 11px;
                                font_weight: 700;
                                color: Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Volume Slider with Mute
                    HorizontalLayout {
                        spacing: 6px;
                        width: 125px;

                        AuriIconButton {
                            icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                            icon_size: 16px;
                            btn_size: 28px;
                            tooltip: root.volume == 0.0 ? "Unmute" : "Mute";
                            clicked => {
                                if root.volume > 0.0 {
                                    root.volume_changed(0.0);
                                } else {
                                    root.volume_changed(0.8);
                                }
                            }
                        }

                        AuriSlider {
                            width: 88px;
                            value: root.volume;
                            value_changed(val) => { root.volume_changed(val); }
                        }
                    }

                    // Fast Mode Switchers
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/mini.svg");
                            icon_size: 16px;
                            btn_size: 32px;
                            tooltip: "Switch to Floating Mini Player (Ref 2)";
                            clicked => { root.switch_to_mini(); }
                        }

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/gamepad.svg");
                            icon_size: 16px;
                            btn_size: 32px;
                            tooltip: "Switch to Gaming Mode (0% GPU)";
                            clicked => { root.switch_to_gaming(); }
                        }
                    }
                }

                // ==========================================
                // MAIN SCROLLABLE CONTENT REGION
                // ==========================================
                ScrollView {
                    vertical_stretch: 1;

                    VerticalLayout {
                        padding_bottom: 24px;
                        spacing: 24px;

                        // ------------------------------------------
                        // VIEW 1: HOME VIEW
                        // ------------------------------------------
                        if root.current_nav == "home": VerticalLayout {
                            spacing: 24px;

                            // Featured Artist Banner (Strictly Left-Aligned)
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: @linear-gradient(90deg, #181A2ECC 0%, #121422CC 60%, #0E0F1ACC 100%);
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                HorizontalLayout {
                                    padding: 22px;
                                    spacing: 20px;
                                    alignment: start;

                                    // Left Artist Portrait
                                    Rectangle {
                                        width: 76px;
                                        height: 76px;
                                        border-radius: Theme.radius_md;
                                        background: @linear-gradient(135deg, #F43F5E 0%, #8B5CF6 100%);
                                        border-width: 2px;
                                        border-color: Theme.border_glass_highlight;

                                        Text {
                                            text: "TH";
                                            font_size: 26px;
                                            font_weight: 800;
                                            color: #FFFFFF;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }

                                    // Left Text Hierarchy
                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        alignment: center;
                                        spacing: 6px;

                                        Text {
                                            text: "FEATURED ARTIST";
                                            font_size: 10px;
                                            font_weight: 800;
                                            letter_spacing: 1.2px;
                                            color: Theme.accent_hover;
                                        }

                                        Text {
                                            text: "Taco Hemingway";
                                            font_size: 24px;
                                            font_weight: 800;
                                            color: #FFFFFF;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            Rectangle {
                                                width: 96px;
                                                height: 28px;
                                                border-radius: Theme.radius_pill;
                                                background: Theme.accent;

                                                TouchArea {
                                                    clicked => { root.toggle_play(); }
                                                }

                                                Text {
                                                    text: root.is_playing ? "⏸ Pause" : "▶ Play All";
                                                    font_size: 11px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }

                                            Rectangle {
                                                width: 80px;
                                                height: 28px;
                                                border-radius: Theme.radius_pill;
                                                background: Theme.bg_surface_elevated;
                                                border-width: 1px;
                                                border-color: Theme.border_glass;

                                                Text {
                                                    text: "+ Follow";
                                                    font_size: 11px;
                                                    font_weight: 600;
                                                    color: Theme.text_primary;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Albums Section (Square Cards, Left-Aligned Titles)
                            VerticalLayout {
                                spacing: 12px;

                                HorizontalLayout {
                                    Text {
                                        text: "Albums";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                        horizontal_stretch: 1;
                                    }
                                    Text {
                                        text: "Sort by Year ▼";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    for album in root.home_albums: Rectangle {
                                        horizontal_stretch: 1;
                                        border-radius: Theme.radius_md;
                                        background: album_item_touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
                                        border-width: 1px;
                                        border-color: Theme.border_glass;

                                        album_item_touch := TouchArea {
                                            clicked => { root.play_album(album.id); }
                                        }

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 8px;

                                            Rectangle {
                                                height: 100px;
                                                border-radius: Theme.radius_sm;
                                                background: @linear-gradient(135deg, album.color_hue.darker(50%) 0%, #0E1017 100%);
                                                border-width: 1px;
                                                border-color: Theme.border_glass;

                                                // Vinyl disc groove motif
                                                Rectangle {
                                                    width: 48px;
                                                    height: 48px;
                                                    border-radius: 24px;
                                                    background: @linear-gradient(135deg, #1A1D2B 0%, #0A0B10 100%);
                                                    border-width: 2px;
                                                    border-color: Theme.border_glass_highlight;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;

                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        border-radius: 8px;
                                                        background: album.color_hue;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;

                                                        Rectangle {
                                                            width: 6px;
                                                            height: 6px;
                                                            border-radius: 3px;
                                                            background: #07080B;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: start;

                                                Text {
                                                    text: album.title;
                                                    font_size: 12px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: album.year;
                                                    font_size: 10px;
                                                    color: Theme.text_muted;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Popular Tracks & Similar Artists Columns (Reference 1 Left-Aligned Layout)
                            HorizontalLayout {
                                spacing: 24px;

                                // Popular Tracks Precision Table
                                VerticalLayout {
                                    horizontal_stretch: 3;
                                    spacing: 8px;

                                    Text {
                                        text: "Popular";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    VerticalLayout {
                                        spacing: 1px;

                                        for track[idx] in root.home_tracks: Rectangle {
                                            height: 44px;
                                            border-radius: Theme.radius_sm;
                                            background: pop_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                            pop_touch := TouchArea {
                                                clicked => {
                                                    root.play_track(track.id, track.title, track.artist, 214);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding_left: 8px;
                                                padding_right: 8px;
                                                spacing: 12px;

                                                // Column 1: Index
                                                Text {
                                                    text: idx + 1;
                                                    font_size: 13px;
                                                    font_weight: 600;
                                                    color: Theme.text_muted;
                                                    width: 18px;
                                                    vertical_alignment: center;
                                                }

                                                // Column 2: Stacked Title & Subtitle (Left-Aligned)
                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;

                                                    Text {
                                                        text: track.title;
                                                        font_size: 13px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: track.artist + (track.album != "" ? " • " + track.album : "");
                                                        font_size: 11px;
                                                        color: Theme.text_muted;
                                                        overflow: elide;
                                                    }
                                                }

                                                // Column 3: Format Badge
                                                Rectangle {
                                                    width: 52px;
                                                    height: 18px;
                                                    border-radius: 4px;
                                                    background: Theme.badge_bg;
                                                    border-width: 1px;
                                                    border-color: Theme.badge_border;

                                                    Text {
                                                        text: track.format_badge;
                                                        font_size: 9px;
                                                        font_weight: 700;
                                                        color: Theme.badge_text;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }

                                                // Column 4: Duration
                                                Text {
                                                    text: track.duration;
                                                    font_size: 11px;
                                                    color: Theme.text_muted;
                                                    vertical_alignment: center;
                                                }

                                                // Column 5: Favorite Action
                                                AuriIconButton {
                                                    icon_source: track.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                                                    icon_size: 13px;
                                                    btn_size: 26px;
                                                    active_color: Theme.favorite_active;
                                                    is_active: track.is_favorite;
                                                    tooltip: "Favorite";
                                                    clicked => { root.toggle_track_favorite(track.id); }
                                                }

                                                // Column 6: Play Action
                                                AuriIconButton {
                                                    icon_source: @image-url("../assets/icons/play.svg");
                                                    icon_size: 13px;
                                                    btn_size: 26px;
                                                    tooltip: "Play " + track.title;
                                                    clicked => {
                                                        root.play_track(track.id, track.title, track.artist, 214);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Similar Artists Precision Column (Reference 1 Style)
                                VerticalLayout {
                                    horizontal_stretch: 2;
                                    spacing: 8px;

                                    Text {
                                        text: "Similar Artist";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;

                                        for artist in root.similar_artists: Rectangle {
                                            height: 44px;
                                            border-radius: Theme.radius_sm;
                                            background: sim_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                            sim_touch := TouchArea {
                                                clicked => {
                                                    root.perform_search(artist.name);
                                                    root.navigate("search");
                                                }
                                            }

                                            HorizontalLayout {
                                                padding_left: 8px;
                                                padding_right: 8px;
                                                spacing: 12px;

                                                Rectangle {
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 16px;
                                                    background: @linear-gradient(135deg, #1E2034 0%, #2A2D48 100%);
                                                    border-width: 1px;
                                                    border-color: Theme.border_glass_highlight;

                                                    Image {
                                                        source: @image-url("../assets/icons/queue.svg");
                                                        width: 13px;
                                                        height: 13px;
                                                        image-fit: contain;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: artist.name;
                                                        font_size: 13px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: artist.role;
                                                        font_size: 11px;
                                                        color: Theme.text_muted;
                                                        overflow: elide;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 64px;
                                                    height: 24px;
                                                    border-radius: Theme.radius_pill;
                                                    background: fol_touch.has_hover ? Theme.accent : Theme.bg_surface_elevated;
                                                    border-width: 1px;
                                                    border-color: Theme.border_glass;

                                                    fol_touch := TouchArea {}

                                                    Text {
                                                        text: "+ Follow";
                                                        font_size: 10px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 2: SEARCH VIEW (Precision Table Structure)
                        // ------------------------------------------
                        if root.current_nav == "search": VerticalLayout {
                            spacing: 14px;

                            Text {
                                text: root.search_query != "" ? "Search Results for \"" + root.search_query + "\"" : "Search YouTube Music Catalog";
                                font_size: 20px;
                                font_weight: 800;
                                color: #FFFFFF;
                            }

                            if root.search_results.length == 0: Rectangle {
                                height: 180px;
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 10px;

                                    Image {
                                        source: @image-url("../assets/icons/search.svg");
                                        width: 32px;
                                        height: 32px;
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                    }
                                    Text {
                                        text: root.search_query == "" ? "Type any song, artist or album name above and press Enter." : "No tracks found for \"" + root.search_query + "\".";
                                        font_size: 13px;
                                        color: Theme.text_secondary;
                                        horizontal_alignment: center;
                                    }
                                }
                            }

                            // Table of Results (Apple Music Table, Strict Left Alignment)
                            if root.search_results.length > 0: VerticalLayout {
                                spacing: 2px;

                                // Table Column Headers
                                HorizontalLayout {
                                    padding_left: 12px;
                                    padding_right: 12px;
                                    spacing: 14px;
                                    height: 22px;

                                    Text {
                                        text: "#";
                                        font_size: 11px;
                                        font_weight: 700;
                                        color: Theme.text_muted;
                                        width: 18px;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: "TITLE / ARTIST";
                                        font_size: 10px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                        horizontal_stretch: 1;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: "FORMAT";
                                        font_size: 10px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                        width: 58px;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: "TIME";
                                        font_size: 10px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                        width: 44px;
                                        horizontal_alignment: right;
                                        vertical_alignment: center;
                                    }
                                    Rectangle { width: 28px; } // Spacer for play action column
                                }

                                for res[idx] in root.search_results: Rectangle {
                                    height: 46px;
                                    border-radius: Theme.radius_sm;
                                    background: search_row_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    search_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(res.id, res.title, res.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 14px;

                                        // Col 1: Index Number
                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 18px;
                                            vertical_alignment: center;
                                        }

                                        // Col 2: Artwork
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        // Col 3: Title & Subtitle (Left-Aligned)
                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: res.title;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: res.artist;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        // Col 4: Format Badge
                                        Rectangle {
                                            width: 58px;
                                            height: 18px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            border-width: 1px;
                                            border-color: Theme.badge_border;

                                            Text {
                                                text: res.format_badge;
                                                font_size: 9px;
                                                font_weight: 700;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        // Col 5: Duration
                                        Text {
                                            text: res.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            width: 44px;
                                            horizontal_alignment: right;
                                            vertical_alignment: center;
                                        }

                                        // Col 6: Instant Play Button
                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play " + res.title;
                                            clicked => {
                                                root.play_track(res.id, res.title, res.artist, 200);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 3: ALBUMS VIEW
                        // ------------------------------------------
                        if root.current_nav == "albums": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                Text {
                                    text: "Albums Collection";
                                    font_size: 20px;
                                    font_weight: 800;
                                    color: #FFFFFF;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: root.all_albums.length + " Albums in Library";
                                    font_size: 12px;
                                    color: Theme.text_muted;
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                for alb in root.all_albums: Rectangle {
                                    horizontal_stretch: 1;
                                    height: 170px;
                                    border-radius: Theme.radius_md;
                                    background: alb_card_touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
                                    border-width: 1px;
                                    border-color: Theme.border_glass;

                                    alb_card_touch := TouchArea {
                                        clicked => { root.play_album(alb.id); }
                                    }

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        Rectangle {
                                            height: 96px;
                                            border-radius: Theme.radius_sm;
                                            background: alb.color_hue;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/album.svg");
                                                width: 32px;
                                                height: 32px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: start;
                                            Text {
                                                text: alb.title;
                                                font_size: 12px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: alb.artist + " (" + alb.year + ")";
                                                font_size: 10px;
                                                color: Theme.text_muted;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 4: LOCAL FILES VIEW
                        // ------------------------------------------
                        if root.current_nav == "local": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Local Music Library";
                                        font_size: 20px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }
                                    Text {
                                        text: "Path: " + root.local_music_path;
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                Rectangle {
                                    width: 120px;
                                    height: 30px;
                                    border-radius: Theme.radius_pill;
                                    background: Theme.bg_surface_elevated;
                                    border-width: 1px;
                                    border-color: Theme.border_glass;

                                    TouchArea {
                                        clicked => { root.rescan_local(root.local_music_path); }
                                    }

                                    Text {
                                        text: "🔄 Rescan Folder";
                                        font_size: 11px;
                                        font_weight: 700;
                                        color: #FFFFFF;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;

                                for ltrack[idx] in root.local_tracks: Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_sm;
                                    background: local_row_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    local_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(ltrack.id, ltrack.title, ltrack.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 14px;

                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 18px;
                                            vertical_alignment: center;
                                        }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: ltrack.title;
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ltrack.artist + " • " + ltrack.album;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 54px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            border-width: 1px;
                                            border-color: Theme.badge_border;
                                            y: (parent.height - self.height) / 2;

                                            Text {
                                                text: ltrack.format_badge;
                                                font_size: 9px;
                                                font_weight: 800;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Text {
                                            text: ltrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play " + ltrack.title;
                                            clicked => {
                                                root.play_track(ltrack.id, ltrack.title, ltrack.artist, 200);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 5: FAVORITES VIEW
                        // ------------------------------------------
                        if root.current_nav == "favorites": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Favorite Tracks";
                                        font_size: 20px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }
                                    Text {
                                        text: root.favorite_tracks.length + " Starred Songs";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                Rectangle {
                                    width: 100px;
                                    height: 30px;
                                    border-radius: Theme.radius_pill;
                                    background: Theme.accent;

                                    TouchArea {
                                        clicked => {
                                            if root.favorite_tracks.length > 0 {
                                                root.play_track(root.favorite_tracks[0].id, root.favorite_tracks[0].title, root.favorite_tracks[0].artist, 200);
                                            }
                                        }
                                    }

                                    Text {
                                        text: "▶ Play All";
                                        font_size: 12px;
                                        font_weight: 700;
                                        color: #FFFFFF;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;

                                for ftrack[idx] in root.favorite_tracks: Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_sm;
                                    background: fav_row_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    fav_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(ftrack.id, ftrack.title, ftrack.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 14px;

                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 18px;
                                            vertical_alignment: center;
                                        }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: ftrack.title;
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ftrack.artist;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Text {
                                            text: ftrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/heart-filled.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            active_color: Theme.favorite_active;
                                            is_active: true;
                                            tooltip: "Remove from Favorites";
                                            clicked => { root.toggle_track_favorite(ftrack.id); }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 6: SETTINGS VIEW (Overhauled macOS / Apple Style)
                        // ------------------------------------------
                        if root.current_nav == "settings": VerticalLayout {
                            spacing: 18px;

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Settings & System Performance";
                                    font_size: 22px;
                                    font_weight: 800;
                                    color: #FFFFFF;
                                }
                                Text {
                                    text: "Configure audio decoding, latency buffers, and background gaming optimizations.";
                                    font_size: 12px;
                                    color: Theme.text_secondary;
                                }
                            }

                            // Section 1: Audio Engine Architecture (Dual-Engine)
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "AUDIO ENGINE ARCHITECTURE";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    // Option 1: Native WASAPI
                                    Rectangle {
                                        height: 68px;
                                        border-radius: Theme.radius_md;
                                        background: root.audio_engine_name == "Native WASAPI" ? #6366F126 : (eng1_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated);
                                        border-width: 1px;
                                        border-color: root.audio_engine_name == "Native WASAPI" ? Theme.accent : Theme.border_glass;

                                        eng1_touch := TouchArea {
                                            clicked => { root.switch_audio_engine(0); }
                                        }

                                        HorizontalLayout {
                                            padding_left: 16px;
                                            padding_right: 16px;
                                            spacing: 14px;
                                            alignment: center;

                                            Image {
                                                source: @image-url("../assets/icons/gamepad.svg");
                                                width: 22px;
                                                height: 22px;
                                                image-fit: contain;
                                            }

                                            VerticalLayout {
                                                horizontal_stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Native WASAPI Shared Mode (Gaming Recommended)";
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                }
                                                Text {
                                                    text: "Pure Rust Symphonia AAC/Opus/FLAC decoder + Catmull-Rom resampler. MMCSS real-time thread, 0% GPU, < 35 MB RAM.";
                                                    font_size: 11px;
                                                    color: Theme.text_secondary;
                                                }
                                            }

                                            if root.audio_engine_name == "Native WASAPI": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: Theme.accent;

                                                Text {
                                                    text: "✓";
                                                    font_size: 11px;
                                                    font_weight: 800;
                                                    color: #FFFFFF;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Option 2: Studio libmpv
                                    Rectangle {
                                        height: 68px;
                                        border-radius: Theme.radius_md;
                                        background: root.audio_engine_name != "Native WASAPI" ? #6366F126 : (eng2_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated);
                                        border-width: 1px;
                                        border-color: root.audio_engine_name != "Native WASAPI" ? Theme.accent : Theme.border_glass;

                                        eng2_touch := TouchArea {
                                            clicked => { root.switch_audio_engine(1); }
                                        }

                                        HorizontalLayout {
                                            padding_left: 16px;
                                            padding_right: 16px;
                                            spacing: 14px;
                                            alignment: center;

                                            Image {
                                                source: @image-url("../assets/icons/settings.svg");
                                                width: 22px;
                                                height: 22px;
                                                image-fit: contain;
                                            }

                                            VerticalLayout {
                                                horizontal_stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Studio libmpv Engine (Audiophile)";
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                }
                                                Text {
                                                    text: "C libmpv backend with gapless lookahead deck, crossfade, and Soxr polyphase Sinc resampling.";
                                                    font_size: 11px;
                                                    color: Theme.text_secondary;
                                                }
                                            }

                                            if root.audio_engine_name != "Native WASAPI": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: Theme.accent;

                                                Text {
                                                    text: "✓";
                                                    font_size: 11px;
                                                    font_weight: 800;
                                                    color: #FFFFFF;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Section 2: Audio Dynamics & Fidelity Processing
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "DYNAMICS & FIDELITY PROCESSING";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: "YouTube Music -7.0 LUFS Target Normalization & Peak Limiter";
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                            }
                                            Text {
                                                text: "Applies continuous gain scaling matching YouTube Music standards with zero digital clipping.";
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                            }
                                        }

                                        Rectangle {
                                            width: 48px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: root.loudness_norm_enabled ? Theme.accent : Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            TouchArea {
                                                clicked => { root.toggle_loudness(!root.loudness_norm_enabled); }
                                            }

                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: #FFFFFF;
                                                x: root.loudness_norm_enabled ? parent.width - self.width - 3px : 3px;
                                                y: 3px;
                                                animate x { duration: 120ms; }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "MMCSS Scheduling:";
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                        }
                                        Text {
                                            text: "AvSetMmThreadCharacteristicsW(\"Audio\") Priority Active";
                                            font_size: 11px;
                                            font_weight: 700;
                                            color: Theme.success;
                                        }
                                    }
                                }
                            }

                            // Section 3: Local Library Directory Path
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "LOCAL MUSIC DIRECTORY";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 38px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            HorizontalLayout {
                                                padding_left: 14px;
                                                padding_right: 14px;
                                                TextInput {
                                                    text <=> root.local_music_path;
                                                    font_size: 12px;
                                                    color: #FFFFFF;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 110px;
                                            height: 38px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.accent;

                                            TouchArea {
                                                clicked => { root.rescan_local(root.local_music_path); }
                                            }

                                            Text {
                                                text: "Scan Path";
                                                font_size: 12px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // 3. RIGHT PANEL: PLAY QUEUE & NOW PLAYING (Ref 1 Glass)
        // ==========================================
        Rectangle {
            width: 270px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_glass;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Play queue";
                        font_size: 16px;
                        font_weight: 800;
                        color: #FFFFFF;
                        horizontal_stretch: 1;
                    }
                    Text {
                        text: root.queue_tracks.length + " Tracks";
                        font_size: 11px;
                        color: Theme.text_muted;
                        vertical_alignment: center;
                    }
                }

                // Reference 1 Now Playing Glass Card
                Rectangle {
                    height: 220px;
                    border-radius: Theme.radius_lg;
                    background: Theme.bg_card;
                    border-width: 1px;
                    border-color: Theme.border_glass;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        alignment: center;

                        // Track Artwork (Rounded with glowing playing state)
                        Rectangle {
                            width: 54px;
                            height: 54px;
                            border-radius: 12px;
                            clip: true;
                            background: #151722;
                            border-width: 1.5px;
                            border-color: root.is_playing ? Theme.accent : Theme.border_glass;

                            if root.has_artwork : Image {
                                source: root.artwork;
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                            }

                            if !root.has_artwork : Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: @linear-gradient(135deg, #EC4899 0%, #8B5CF6 100%);

                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: #07080B;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // Track Title & Artist
                        VerticalLayout {
                            spacing: 1px;
                            alignment: center;
                            Text {
                                text: root.track_title;
                                font_size: 13px;
                                font_weight: 700;
                                color: #FFFFFF;
                                horizontal_alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.track_artist;
                                font_size: 10px;
                                color: Theme.text_secondary;
                                horizontal_alignment: center;
                                overflow: elide;
                            }
                        }

                        // Seekbar & Time
                        VerticalLayout {
                            spacing: 2px;

                            AuriSlider {
                                value: root.track_progress;
                                value_changed(val) => { root.seek(val); }
                            }

                            HorizontalLayout {
                                Text {
                                    text: root.track_elapsed;
                                    font_size: 9px;
                                    color: Theme.text_muted;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: root.track_duration;
                                    font_size: 9px;
                                    color: Theme.text_muted;
                                }
                            }
                        }

                        // Transport Controls
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/shuffle.svg");
                                icon_size: 13px;
                                btn_size: 26px;
                                is_active: root.is_shuffle;
                                tooltip: "Shuffle";
                                clicked => { root.toggle_shuffle(); }
                            }

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/prev.svg");
                                icon_size: 15px;
                                btn_size: 26px;
                                tooltip: "Previous";
                                clicked => { root.prev_track(); }
                            }

                            AuriPlayButton {
                                button_size: 34px;
                                is_playing: root.is_playing;
                                clicked => { root.toggle_play(); }
                            }

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/next.svg");
                                icon_size: 15px;
                                btn_size: 26px;
                                tooltip: "Next";
                                clicked => { root.next_track(); }
                            }

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/repeat.svg");
                                icon_size: 13px;
                                btn_size: 26px;
                                is_active: root.is_repeat;
                                tooltip: "Repeat";
                                clicked => { root.toggle_repeat(); }
                            }
                        }
                    }
                }

                // Up Next Queue Header
                Text {
                    text: "Up Next";
                    font_size: 12px;
                    font_weight: 800;
                    color: Theme.text_muted;
                }

                // Up Next Items List (Scrollable)
                ScrollView {
                    vertical_stretch: 1;

                    VerticalLayout {
                        padding_right: 14px;
                        spacing: 2px;

                        for qtrack in root.queue_tracks: Rectangle {
                            height: 40px;
                            border-radius: Theme.radius_sm;
                            background: q_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                            q_touch := TouchArea {
                                clicked => {
                                    root.play_track(qtrack.id, qtrack.title, qtrack.artist, 200);
                                }
                            }

                            HorizontalLayout {
                                padding_left: 8px;
                                padding_right: 8px;
                                spacing: 10px;

                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: Theme.bg_surface_elevated;
                                    border-width: 1px;
                                    border-color: Theme.border_glass;

                                    Image {
                                        source: @image-url("../assets/icons/music.svg");
                                        width: 12px;
                                        height: 12px;
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: qtrack.title;
                                        font_size: 12px;
                                        font_weight: 600;
                                        color: #FFFFFF;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: qtrack.artist;
                                        font_size: 10px;
                                        color: Theme.text_muted;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: qtrack.duration;
                                    font_size: 10px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
