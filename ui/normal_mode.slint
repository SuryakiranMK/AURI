// AURI Normal Mode View (Complete Desktop Experience)
import { Theme } from "theme.slint";
import { TrackData, AlbumData, ArtistData, QueueItemData } from "models.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider, AuriNavButton } from "components.slint";

export component NormalModeView inherits Rectangle {
    in property <int> layout_variant: 0; // 0 = Variant A1 (Right Card Ref 1), 1 = Variant A2 (Docked Bottom Bar)
    in property <string> current_nav: "home";
    in property <bool> is_playing: false;
    in property <string> track_title: "Saldo 0,7";
    in property <string> track_artist: "Taco Hemingway, Szprycer";
    in property <string> track_duration: "3:34";
    in property <string> track_elapsed: "1:18";
    in property <float> track_progress: 0.36;
    in property <float> volume: 0.72;
    in property <bool> is_favorite: true;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in-out property <bool> auto_game_mode: true;
    in-out property <string> active_game: "";
    in-out property <string> ram_usage: "35.0 MB";
    in-out property <string> search_query: "";
    in-out property <[TrackData]> search_results: [];

    // Callbacks
    callback navigate(string);
    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_shuffle();
    callback toggle_repeat();
    callback switch_to_mini();
    callback switch_to_gaming();
    callback toggle_auto_game();
    callback trim_ram();
    callback perform_search(string);
    callback play_stream_track(string, string, string, int);

    background: Theme.bg_app;

    VerticalLayout {
        spacing: 0;
        padding: 0;

        // Top main split (Sidebar + Main + Optional Right Queue)
        HorizontalLayout {
            spacing: 0;
            horizontal_stretch: 1;

            // ==========================================
            // LEFT SIDEBAR
            // ==========================================
            Rectangle {
                width: 220px;
                background: Theme.bg_sidebar;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 18px;
                    spacing: 16px;

                    // Brand Logo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: Theme.radius_md;
                            background: Theme.accent;

                            Text {
                                text: "A";
                                font_size: 16px;
                                font_weight: 800;
                                color: Theme.text_primary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }

                        Text {
                            text: "AURI";
                            font_size: 18px;
                            font_weight: 800;
                            letter_spacing: 1px;
                            color: Theme.text_primary;
                            vertical_alignment: center;
                        }

                        Rectangle {
                            width: 44px;
                            height: 18px;
                            border-radius: 9px;
                            background: Theme.badge_bg;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: "0.1.0";
                                font_size: 10px;
                                color: Theme.badge_text;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Main Menu Section
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "MENU";
                            font_size: 11px;
                            font_weight: 700;
                            letter_spacing: 0.8px;
                            color: Theme.text_muted;
                        }

                        AuriNavButton {
                            icon: "⌂";
                            label: "Home";
                            is_selected: root.current_nav == "home";
                            clicked => { root.navigate("home"); }
                        }
                        AuriNavButton {
                            icon: "◎";
                            label: "Albums";
                            is_selected: root.current_nav == "albums";
                            clicked => { root.navigate("albums"); }
                        }
                        AuriNavButton {
                            icon: "🖿";
                            label: "Local Files";
                            badge: "482";
                            is_selected: root.current_nav == "local";
                            clicked => { root.navigate("local"); }
                        }
                        AuriNavButton {
                            icon: "♥";
                            label: "Favorites";
                            is_selected: root.current_nav == "favorites";
                            clicked => { root.navigate("favorites"); }
                        }
                        AuriNavButton {
                            icon: "≡";
                            label: "Playlists";
                            is_selected: root.current_nav == "playlists";
                            clicked => { root.navigate("playlists"); }
                        }
                    }

                    // Quick Library (Replacing Removed Friends Panel)
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "LIBRARY SHORTCUTS";
                            font_size: 11px;
                            font_weight: 700;
                            letter_spacing: 0.8px;
                            color: Theme.text_muted;
                        }

                        AuriNavButton {
                            icon: "↓";
                            label: "Downloads";
                            is_selected: root.current_nav == "downloads";
                            clicked => { root.navigate("downloads"); }
                        }
                        AuriNavButton {
                            icon: "⏱";
                            label: "Recently Added";
                            is_selected: root.current_nav == "recent";
                            clicked => { root.navigate("recent"); }
                        }
                        AuriNavButton {
                            icon: "◈";
                            label: "Hi-Res FLACs";
                            badge: "96k";
                            is_selected: root.current_nav == "hires";
                            clicked => { root.navigate("hires"); }
                        }
                    }

                    // Spacer
                    Rectangle { vertical_stretch: 1; }

                    // Mode Switcher Controls
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "OPERATING MODES";
                            font_size: 11px;
                            font_weight: 700;
                            letter_spacing: 0.8px;
                            color: Theme.text_muted;
                        }

                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            TouchArea {
                                clicked => { root.switch_to_mini(); }
                            }

                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                spacing: 8px;

                                Text {
                                    text: "◱";
                                    font_size: 14px;
                                    color: Theme.accent_hover;
                                    vertical_alignment: center;
                                }
                                Text {
                                    text: "Mini Player";
                                    font_size: 12px;
                                    font_weight: 600;
                                    color: Theme.text_primary;
                                    vertical_alignment: center;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: "50 MB";
                                    font_size: 10px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: #1A1325;
                            border-width: 1px;
                            border-color: #4C1D95;

                            TouchArea {
                                clicked => { root.switch_to_gaming(); }
                            }

                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                spacing: 8px;

                                Text {
                                    text: "⚡";
                                    font_size: 14px;
                                    color: #A855F7;
                                    vertical_alignment: center;
                                }
                                Text {
                                    text: "Gaming Mode";
                                    font_size: 12px;
                                    font_weight: 600;
                                    color: #E9D5FF;
                                    vertical_alignment: center;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: "0% GPU";
                                    font_size: 10px;
                                    color: #A855F7;
                                    vertical_alignment: center;
                                }
                            }
                        }

                        AuriNavButton {
                            icon: "⚙";
                            label: "Settings";
                            is_selected: root.current_nav == "settings";
                            clicked => { root.navigate("settings"); }
                        }
                    }
                }
            }

            // ==========================================
            // CENTER MAIN CONTENT WORKSPACE
            // ==========================================
            Rectangle {
                horizontal_stretch: 1;
                background: Theme.bg_app;

                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;

                    // Top Bar (Search + Quick Status + Volume + Profile)
                    HorizontalLayout {
                        spacing: 16px;
                        height: 40px;

                        // Search Pill Input
                        Rectangle {
                            horizontal_stretch: 1;
                            height: 38px;
                            border-radius: Theme.radius_pill;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            HorizontalLayout {
                                padding_left: 16px;
                                padding_right: 16px;
                                spacing: 10px;

                                Text {
                                    text: "🔍";
                                    font_size: 13px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }

                                search_input := TextInput {
                                    text <=> root.search_query;
                                    font_size: 13px;
                                    color: Theme.text_primary;
                                    vertical_alignment: center;
                                    horizontal_stretch: 1;
                                    accepted => {
                                        root.navigate("search");
                                        root.perform_search(self.text);
                                    }
                                }

                                if search_input.text == "": Text {
                                    text: "Search YouTube Music & local library (press Enter)...";
                                    font_size: 12px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }
                            }
                        }

                        // Volume Control
                        HorizontalLayout {
                            spacing: 8px;
                            width: 130px;

                            Text {
                                text: "🔊";
                                font_size: 13px;
                                color: Theme.text_secondary;
                                vertical_alignment: center;
                            }
                            AuriSlider {
                                value: root.volume;
                                value_changed(val) => { root.volume_changed(val); }
                            }
                        }

                        // User Avatar
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: #3B82F6;

                            Text {
                                text: "A";
                                font_size: 15px;
                                font_weight: 700;
                                color: Theme.text_primary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Content Viewport
                    if root.current_nav == "home": VerticalLayout {
                        spacing: 22px;
                        vertical_stretch: 1;

                        // Hero Artist Header (Reference 1 style)
                        Rectangle {
                            height: 100px;
                            border-radius: Theme.radius_lg;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            HorizontalLayout {
                                padding: 16px;
                                spacing: 20px;

                                // Artist Avatar
                                Rectangle {
                                    width: 68px;
                                    height: 68px;
                                    border-radius: 34px;
                                    background: #D97706;

                                    Text {
                                        text: "🎤";
                                        font_size: 28px;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    horizontal_stretch: 1;

                                    Text {
                                        text: "Taco Hemingway";
                                        font_size: 26px;
                                        font_weight: 800;
                                        color: Theme.text_primary;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        Rectangle {
                                            width: 74px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: Theme.bg_surface_elevated;

                                            Text {
                                                text: "+ Follow";
                                                font_size: 11px;
                                                font_weight: 600;
                                                color: Theme.text_secondary;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Text {
                                            text: "1,842,109 monthly listeners • 6 Studio Albums";
                                            font_size: 12px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Albums Row (Reference 1 Style)
                        VerticalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                Text {
                                    text: "Albums";
                                    font_size: 18px;
                                    font_weight: 700;
                                    color: Theme.text_primary;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: "Sort by ▾";
                                    font_size: 12px;
                                    color: Theme.text_muted;
                                }
                            }

                            // 5 Album Cards in a clean row
                            HorizontalLayout {
                                spacing: 14px;

                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 140px;
                                    border-radius: Theme.radius_md;
                                    background: #EF444426;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 80px;
                                            border-radius: Theme.radius_sm;
                                            background: #EF4444;
                                        }
                                        Text { text: "Pocztówka z WWA"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                        Text { text: "2019"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 140px;
                                    border-radius: Theme.radius_md;
                                    background: #3B82F626;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 80px;
                                            border-radius: Theme.radius_sm;
                                            background: #3B82F6;
                                        }
                                        Text { text: "Café Belga"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                        Text { text: "2018"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 140px;
                                    border-radius: Theme.radius_md;
                                    background: #10B98126;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 80px;
                                            border-radius: Theme.radius_sm;
                                            background: #10B981;
                                        }
                                        Text { text: "Flagey EP"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                        Text { text: "2018"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 140px;
                                    border-radius: Theme.radius_md;
                                    background: #8B5CF626;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 80px;
                                            border-radius: Theme.radius_sm;
                                            background: #8B5CF6;
                                        }
                                        Text { text: "Szprycer"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                        Text { text: "2017"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 140px;
                                    border-radius: Theme.radius_md;
                                    background: #F59E0B26;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 80px;
                                            border-radius: Theme.radius_sm;
                                            background: #F59E0B;
                                        }
                                        Text { text: "Marmur"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                        Text { text: "2016"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }
                            }
                        }

                        // Lower Two-Column Section: Popular Tracks + Similar Artists
                        HorizontalLayout {
                            spacing: 20px;
                            vertical_stretch: 1;

                            // Popular Tracks
                            VerticalLayout {
                                horizontal_stretch: 3;
                                spacing: 8px;

                                Text {
                                    text: "Popular Tracks";
                                    font_size: 16px;
                                    font_weight: 700;
                                    color: Theme.text_primary;
                                }

                                // Track Item 1
                                Rectangle {
                                    height: 38px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.bg_surface;
                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 12px;
                                        Text { text: "1"; font_size: 12px; color: Theme.accent; font_weight: 700; vertical_alignment: center; }
                                        Text { text: "Tamagotchi"; font_size: 13px; font_weight: 600; color: Theme.text_primary; vertical_alignment: center; horizontal_stretch: 1; }
                                        Text { text: "Quebonafide, Soma 0,5"; font_size: 11px; color: Theme.text_muted; vertical_alignment: center; }
                                        Text { text: "♥"; font_size: 13px; color: Theme.favorite_active; vertical_alignment: center; }
                                        Text { text: "3:22"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                                    }
                                }

                                // Track Item 2
                                Rectangle {
                                    height: 38px;
                                    border-radius: Theme.radius_md;
                                    background: Colors.transparent;
                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 12px;
                                        Text { text: "2"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                                        Text { text: "Wszystko na niby"; font_size: 13px; font_weight: 600; color: Theme.text_primary; vertical_alignment: center; horizontal_stretch: 1; }
                                        Text { text: "Café Belga"; font_size: 11px; color: Theme.text_muted; vertical_alignment: center; }
                                        Text { text: "♡"; font_size: 13px; color: Theme.text_muted; vertical_alignment: center; }
                                        Text { text: "3:45"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                                    }
                                }

                                // Track Item 3
                                Rectangle {
                                    height: 38px;
                                    border-radius: Theme.radius_md;
                                    background: Colors.transparent;
                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 12px;
                                        Text { text: "3"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                                        Text { text: "W piątki leżę w wannie"; font_size: 13px; font_weight: 600; color: Theme.text_primary; vertical_alignment: center; horizontal_stretch: 1; }
                                        Text { text: "Dawid Podsiadło"; font_size: 11px; color: Theme.text_muted; vertical_alignment: center; }
                                        Text { text: "♥"; font_size: 13px; color: Theme.favorite_active; vertical_alignment: center; }
                                        Text { text: "4:10"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                                    }
                                }
                            }

                            // Similar Artists
                            VerticalLayout {
                                horizontal_stretch: 2;
                                spacing: 8px;

                                Text {
                                    text: "Similar Artists";
                                    font_size: 16px;
                                    font_weight: 700;
                                    color: Theme.text_primary;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #6366F1; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal_stretch: 1;
                                        Text { text: "Dawid Podsiadło"; font_size: 12px; font_weight: 600; color: Theme.text_primary; }
                                        Text { text: "2.4M Listeners"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                    Rectangle {
                                        width: 60px; height: 24px; border-radius: 12px; background: Theme.bg_surface;
                                        y: (parent.height - self.height) / 2;
                                        Text { text: "+ Follow"; font_size: 10px; color: Theme.text_secondary; horizontal_alignment: center; vertical_alignment: center; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #EC4899; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal_stretch: 1;
                                        Text { text: "Billie Eilish"; font_size: 12px; font_weight: 600; color: Theme.text_primary; }
                                        Text { text: "85M Listeners"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                    Rectangle {
                                        width: 60px; height: 24px; border-radius: 12px; background: Theme.bg_surface;
                                        y: (parent.height - self.height) / 2;
                                        Text { text: "+ Follow"; font_size: 10px; color: Theme.text_secondary; horizontal_alignment: center; vertical_alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    // Settings View (When settings tab is selected)
                    if root.current_nav == "settings": VerticalLayout {
                        spacing: 16px;
                        vertical_stretch: 1;

                        Text {
                            text: "AURI Settings & Live UI Variants";
                            font_size: 20px;
                            font_weight: 800;
                            color: Theme.text_primary;
                        }

                        // Normal Mode Switcher Card
                        Rectangle {
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "Normal Mode Layout Variant";
                                    font_size: 14px;
                                    font_weight: 700;
                                    color: Theme.text_primary;
                                }
                                Text {
                                    text: "Choose how the playback controls are positioned in Normal Mode:";
                                    font_size: 12px;
                                    color: Theme.text_muted;
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    Rectangle {
                                        horizontal_stretch: 1;
                                        height: 48px;
                                        border-radius: Theme.radius_md;
                                        background: root.layout_variant == 0 ? Theme.bg_surface_elevated : Theme.bg_card;
                                        border-width: root.layout_variant == 0 ? 2px : 1px;
                                        border-color: root.layout_variant == 0 ? Theme.accent : Theme.border_subtle;

                                        TouchArea {
                                            clicked => { root.navigate("set_var_0"); }
                                        }

                                        HorizontalLayout {
                                            padding: 12px;
                                            spacing: 10px;
                                            Text { text: "▶"; font_size: 14px; color: Theme.accent; vertical_alignment: center; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: "Variant A1 (Reference 1 Style)"; font_size: 12px; font_weight: 600; color: Theme.text_primary; }
                                                Text { text: "Embedded now-playing card inside the Right Play Queue"; font_size: 10px; color: Theme.text_muted; }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        horizontal_stretch: 1;
                                        height: 48px;
                                        border-radius: Theme.radius_md;
                                        background: root.layout_variant == 1 ? Theme.bg_surface_elevated : Theme.bg_card;
                                        border-width: root.layout_variant == 1 ? 2px : 1px;
                                        border-color: root.layout_variant == 1 ? Theme.accent : Theme.border_subtle;

                                        TouchArea {
                                            clicked => { root.navigate("set_var_1"); }
                                        }

                                        HorizontalLayout {
                                            padding: 12px;
                                            spacing: 10px;
                                            Text { text: "⎍"; font_size: 14px; color: Theme.accent; vertical_alignment: center; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: "Variant A2 (Classic Docked Bar)"; font_size: 12px; font_weight: 600; color: Theme.text_primary; }
                                                Text { text: "Persistent 70px bottom bar with full controls & collapsible queue"; font_size: 10px; color: Theme.text_muted; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Performance & Engine Status Card
                        Rectangle {
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "Engine Diagnostics & Performance Target";
                                    font_size: 14px;
                                    font_weight: 700;
                                    color: Theme.text_primary;
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    Rectangle {
                                        horizontal_stretch: 1; height: 50px; border-radius: Theme.radius_sm; background: Theme.bg_card;
                                        VerticalLayout {
                                            padding: 8px; alignment: center;
                                            Text { text: "UI RENDERER"; font_size: 9px; color: Theme.text_muted; }
                                            Text { text: "Femtovg / Hardware 2D"; font_size: 12px; font_weight: 700; color: Theme.accent_hover; }
                                        }
                                    }
                                    Rectangle {
                                        horizontal_stretch: 1; height: 50px; border-radius: Theme.radius_sm; background: Theme.bg_card;
                                        VerticalLayout {
                                            padding: 8px; alignment: center;
                                            Text { text: "IDLE CPU BUDGET"; font_size: 9px; color: Theme.text_muted; }
                                            Text { text: "< 0.5% (0% when idle)"; font_size: 12px; font_weight: 700; color: #10B981; }
                                        }
                                    }
                                    Rectangle {
                                        horizontal_stretch: 1; height: 50px; border-radius: Theme.radius_sm; background: Theme.bg_card;
                                        VerticalLayout {
                                            padding: 8px; alignment: center;
                                            Text { text: "GAMING MODE RAM"; font_size: 9px; color: Theme.text_muted; }
                                            Text { text: "< 35 MB (0.0% GPU)"; font_size: 12px; font_weight: 700; color: #8B5CF6; }
                                        }
                                    }
                                }
                            }
                        }

                        // Anti-Cheat Safe Game Detection & Working Set Trimmer Card
                        Rectangle {
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    Text {
                                        text: "🎮 Anti-Cheat Safe Game Detection & Working Set Purge";
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: Theme.text_primary;
                                        horizontal_stretch: 1;
                                    }

                                    // Auto Game Mode Toggle Pill
                                    Rectangle {
                                        width: 140px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: root.auto_game_mode ? #10B98126 : Theme.bg_card;
                                        border-width: 1px;
                                        border-color: root.auto_game_mode ? #10B981 : Theme.border_subtle;

                                        TouchArea {
                                            clicked => { root.toggle_auto_game(); }
                                        }

                                        Text {
                                            text: root.auto_game_mode ? "Auto-Gaming: ON" : "Auto-Gaming: OFF";
                                            font_size: 11px;
                                            font_weight: 700;
                                            color: root.auto_game_mode ? #10B981 : Theme.text_muted;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: "Passively monitors foreground window via Win32 SetWinEventHook. Zero DLL injection, zero game memory access, 100% compliant with EAC, BattlEye & Vanguard.";
                                    font_size: 11px;
                                    color: Theme.text_muted;
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    Rectangle {
                                        horizontal_stretch: 1;
                                        height: 46px;
                                        border-radius: Theme.radius_sm;
                                        background: Theme.bg_card;

                                        HorizontalLayout {
                                            padding: 10px;
                                            spacing: 8px;
                                            Text { text: "🎯"; font_size: 14px; vertical_alignment: center; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: "DETECTED GAME"; font_size: 9px; color: Theme.text_muted; }
                                                Text {
                                                    text: root.active_game == "" ? "No game running in foreground" : root.active_game;
                                                    font_size: 11px;
                                                    font_weight: 600;
                                                    color: root.active_game == "" ? Theme.text_secondary : #10B981;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        horizontal_stretch: 1;
                                        height: 46px;
                                        border-radius: Theme.radius_sm;
                                        background: Theme.bg_card;

                                        HorizontalLayout {
                                            padding: 10px;
                                            spacing: 8px;
                                            Text { text: "💾"; font_size: 14px; vertical_alignment: center; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: "WORKING SET (RAM)"; font_size: 9px; color: Theme.text_muted; }
                                                Text {
                                                    text: root.ram_usage;
                                                    font_size: 11px;
                                                    font_weight: 700;
                                                    color: #8B5CF6;
                                                }
                                            }
                                        }
                                    }

                                    // Trim RAM Button
                                    Rectangle {
                                        width: 120px;
                                        height: 46px;
                                        border-radius: Theme.radius_sm;
                                        background: #8B5CF626;
                                        border-width: 1px;
                                        border-color: #8B5CF6;

                                        TouchArea {
                                            clicked => { root.trim_ram(); }
                                        }

                                        Text {
                                            text: "⚡ Purge RAM";
                                            font_size: 11px;
                                            font_weight: 700;
                                            color: #A855F7;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Search Results View
                    if root.current_nav == "search": VerticalLayout {
                        spacing: 16px;
                        vertical_stretch: 1;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;

                            Text {
                                text: "🌐 YouTube Music Streaming Results";
                                font_size: 20px;
                                font_weight: 800;
                                color: Theme.text_primary;
                                horizontal_stretch: 1;
                            }

                            Text {
                                text: root.search_query == "" ? "Type a song name in the search bar above" : "Showing results for \"" + root.search_query + "\"";
                                font_size: 12px;
                                color: Theme.text_muted;
                                vertical_alignment: center;
                            }
                        }

                        // Tracks List
                        VerticalLayout {
                            spacing: 8px;

                            for track in root.search_results: Rectangle {
                                height: 52px;
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                HorizontalLayout {
                                    padding_left: 14px;
                                    padding_right: 14px;
                                    spacing: 14px;

                                    // Play Stream Button
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 16px;
                                        background: Theme.accent;
                                        y: (parent.height - self.height) / 2;

                                        TouchArea {
                                            clicked => {
                                                root.play_stream_track(track.id, track.title, track.artist, track.duration_secs);
                                            }
                                        }

                                        Text {
                                            text: "▶";
                                            font_size: 12px;
                                            color: #FFFFFF;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }

                                    // Title & Artist
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal_stretch: 2;
                                        spacing: 3px;

                                        Text {
                                            text: track.title;
                                            font_size: 13px;
                                            font_weight: 700;
                                            color: Theme.text_primary;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: track.artist;
                                            font_size: 11px;
                                            color: Theme.text_secondary;
                                            overflow: elide;
                                        }
                                    }

                                    // Album
                                    Text {
                                        text: track.album;
                                        font_size: 12px;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                        horizontal_stretch: 1;
                                        overflow: elide;
                                    }

                                    // Format Tag
                                    Rectangle {
                                        width: 80px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: #8B5CF626;
                                        border-width: 1px;
                                        border-color: #8B5CF6;
                                        y: (parent.height - self.height) / 2;

                                        Text {
                                            text: track.format_badge;
                                            font_size: 9px;
                                            font_weight: 700;
                                            color: #A855F7;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }

                                    // Duration
                                    Text {
                                        text: track.duration;
                                        font_size: 12px;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                        width: 45px;
                                        horizontal_alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // RIGHT SIDEBAR: PLAY QUEUE (Variant A1 Style)
            // ==========================================
            if root.layout_variant == 0: Rectangle {
                width: 280px;
                background: Theme.bg_sidebar;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 18px;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        Text {
                            text: "Play queue";
                            font_size: 16px;
                            font_weight: 800;
                            color: Theme.text_primary;
                            horizontal_stretch: 1;
                            vertical_alignment: center;
                        }
                        Text {
                            text: "8 / 23";
                            font_size: 11px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }
                    }

                    // EMBEDDED NOW-PLAYING CARD (Exact Reference 1 layout)
                    Rectangle {
                        height: 180px;
                        border-radius: Theme.radius_md;
                        background: Theme.bg_card;
                        border-width: 1px;
                        border-color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            // Circular Artwork Thumbnail
                            Rectangle {
                                width: 54px;
                                height: 54px;
                                border-radius: 27px;
                                background: #EC4899;
                                x: (parent.width - self.width) / 2;

                                Text {
                                    text: "🎵";
                                    font_size: 22px;
                                    horizontal_alignment: center;
                                    vertical_alignment: center;
                                }
                            }

                            // Title & Subtitle
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.track_title;
                                    font_size: 13px;
                                    font_weight: 700;
                                    color: Theme.text_primary;
                                    horizontal_alignment: center;
                                }
                                Text {
                                    text: root.track_artist;
                                    font_size: 11px;
                                    color: Theme.text_muted;
                                    horizontal_alignment: center;
                                }
                            }

                            // Transport Controls
                            HorizontalLayout {
                                alignment: center;
                                spacing: 14px;

                                AuriIconButton {
                                    icon_text: "♥";
                                    is_active: root.is_favorite;
                                    active_color: Theme.favorite_active;
                                    clicked => { root.toggle_favorite(); }
                                }
                                AuriIconButton {
                                    icon_text: "⏮";
                                    clicked => { root.prev_track(); }
                                }
                                AuriPlayButton {
                                    is_playing: root.is_playing;
                                    button_size: 32px;
                                    clicked => { root.toggle_play(); }
                                }
                                AuriIconButton {
                                    icon_text: "⏭";
                                    clicked => { root.next_track(); }
                                }
                                AuriIconButton {
                                    icon_text: "⇄";
                                    is_active: root.is_shuffle;
                                    clicked => { root.toggle_shuffle(); }
                                }
                            }

                            // Seekbar
                            VerticalLayout {
                                spacing: 2px;

                                AuriSlider {
                                    value: root.track_progress;
                                    value_changed(val) => { root.seek(val); }
                                }

                                HorizontalLayout {
                                    Text { text: root.track_elapsed; font_size: 9px; color: Theme.text_muted; }
                                    Rectangle { horizontal_stretch: 1; }
                                    Text { text: root.track_duration; font_size: 9px; color: Theme.text_muted; }
                                }
                            }
                        }
                    }

                    // Upcoming Queue Items
                    Text {
                        text: "NEXT UP";
                        font_size: 10px;
                        font_weight: 700;
                        letter_spacing: 0.8px;
                        color: Theme.text_muted;
                    }

                    VerticalLayout {
                        spacing: 8px;
                        vertical_stretch: 1;

                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius_sm;
                            background: Theme.bg_surface;
                            HorizontalLayout {
                                padding_left: 8px; padding_right: 8px; spacing: 8px;
                                Rectangle { width: 24px; height: 24px; border-radius: 4px; background: #6366F1; y: (parent.height - self.height) / 2; }
                                VerticalLayout {
                                    alignment: center; horizontal_stretch: 1;
                                    Text { text: "all the good girls go to hell"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                    Text { text: "Billie Eilish"; font_size: 9px; color: Theme.text_muted; }
                                }
                                Text { text: "≡"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius_sm;
                            background: Colors.transparent;
                            HorizontalLayout {
                                padding_left: 8px; padding_right: 8px; spacing: 8px;
                                Rectangle { width: 24px; height: 24px; border-radius: 4px; background: #F59E0B; y: (parent.height - self.height) / 2; }
                                VerticalLayout {
                                    alignment: center; horizontal_stretch: 1;
                                    Text { text: "COPYCAT"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                    Text { text: "Billie Eilish"; font_size: 9px; color: Theme.text_muted; }
                                }
                                Text { text: "≡"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius_sm;
                            background: Colors.transparent;
                            HorizontalLayout {
                                padding_left: 8px; padding_right: 8px; spacing: 8px;
                                Rectangle { width: 24px; height: 24px; border-radius: 4px; background: #10B981; y: (parent.height - self.height) / 2; }
                                VerticalLayout {
                                    alignment: center; horizontal_stretch: 1;
                                    Text { text: "900729"; font_size: 11px; font_weight: 600; color: Theme.text_primary; overflow: elide; }
                                    Text { text: "Taco Hemingway"; font_size: 9px; color: Theme.text_muted; }
                                }
                                Text { text: "≡"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // DOCKED PERSISTENT BOTTOM BAR (Variant A2 Style)
        // ==========================================
        if root.layout_variant == 1: Rectangle {
            height: 72px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_subtle;

            HorizontalLayout {
                padding_left: 20px;
                padding_right: 20px;
                spacing: 24px;

                // Left: Track Info & Heart
                HorizontalLayout {
                    width: 240px;
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Theme.radius_sm;
                        background: #EC4899;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "🎵";
                            font_size: 18px;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal_stretch: 1;

                        Text {
                            text: root.track_title;
                            font_size: 13px;
                            font_weight: 700;
                            color: Theme.text_primary;
                            overflow: elide;
                        }
                        Text {
                            text: root.track_artist;
                            font_size: 11px;
                            color: Theme.text_muted;
                            overflow: elide;
                        }
                    }

                    AuriIconButton {
                        icon_text: "♥";
                        is_active: root.is_favorite;
                        active_color: Theme.favorite_active;
                        clicked => { root.toggle_favorite(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Center: Transport Controls & Seekbar
                VerticalLayout {
                    horizontal_stretch: 1;
                    alignment: center;
                    spacing: 6px;

                    // Buttons
                    HorizontalLayout {
                        alignment: center;
                        spacing: 18px;

                        AuriIconButton {
                            icon_text: "⇄";
                            is_active: root.is_shuffle;
                            clicked => { root.toggle_shuffle(); }
                        }
                        AuriIconButton {
                            icon_text: "⏮";
                            clicked => { root.prev_track(); }
                        }
                        AuriPlayButton {
                            is_playing: root.is_playing;
                            button_size: 32px;
                            clicked => { root.toggle_play(); }
                        }
                        AuriIconButton {
                            icon_text: "⏭";
                            clicked => { root.next_track(); }
                        }
                        AuriIconButton {
                            icon_text: "↻";
                            is_active: root.is_repeat;
                            clicked => { root.toggle_repeat(); }
                        }
                    }

                    // Seek Slider with Timers
                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: root.track_elapsed;
                            font_size: 10px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }

                        AuriSlider {
                            value: root.track_progress;
                            value_changed(val) => { root.seek(val); }
                            horizontal_stretch: 1;
                        }

                        Text {
                            text: root.track_duration;
                            font_size: 10px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }
                    }
                }

                // Right: Volume & Fast Mode Switches
                HorizontalLayout {
                    width: 220px;
                    spacing: 12px;
                    alignment: end;

                    Text {
                        text: "🔊";
                        font_size: 13px;
                        color: Theme.text_secondary;
                        vertical_alignment: center;
                    }

                    AuriSlider {
                        value: root.volume;
                        value_changed(val) => { root.volume_changed(val); }
                        width: 80px;
                    }

                    AuriIconButton {
                        icon_text: "◱";
                        clicked => { root.switch_to_mini(); }
                        y: (parent.height - self.height) / 2;
                    }

                    AuriIconButton {
                        icon_text: "⚡";
                        active_color: #A855F7;
                        clicked => { root.switch_to_gaming(); }
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}
