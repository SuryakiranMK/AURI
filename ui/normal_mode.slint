// AURI Normal Mode View (Apple Music & YouTube Music Sleek Aesthetic)
import { Theme } from "theme.slint";
import { TrackData } from "models.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider, AuriNavButton } from "components.slint";

export component NormalModeView inherits Rectangle {
    in property <int> layout_variant: 0; // 0 = Variant A1 (Right Queue Panel), 1 = Variant A2 (Docked Bottom Bar)
    in property <string> current_nav: "home";
    in property <bool> is_playing: false;
    in property <string> track_title: "Saldo 0,7";
    in property <string> track_artist: "Taco Hemingway";
    in property <string> track_duration: "3:34";
    in property <string> track_elapsed: "1:18";
    in property <float> track_progress: 0.36;
    in property <float> volume: 0.75;
    in property <bool> is_favorite: true;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in-out property <bool> auto_game_mode: true;
    in-out property <string> active_game: "";
    in-out property <string> ram_usage: "35.0 MB";
    in-out property <string> search_query: "";
    in-out property <[TrackData]> search_results: [];

    // Callbacks
    callback navigate(string);
    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_shuffle();
    callback toggle_repeat();
    callback switch_to_mini();
    callback switch_to_gaming();
    callback toggle_auto_game();
    callback trim_ram();
    callback perform_search(string);
    callback play_stream_track(string, string, string, int);

    background: Theme.bg_app;

    VerticalLayout {
        // Main Horizontal Split: Left Sidebar | Center Content | Right Panel
        HorizontalLayout {
            vertical_stretch: 1;

            // ==========================================
            // LEFT SIDEBAR: SLEEK NAVIGATION
            // ==========================================
            Rectangle {
                width: 220px;
                background: Theme.bg_sidebar;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Brand Logo & Version
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: Theme.radius_md;
                            background: Theme.accent;

                            Text {
                                text: "A";
                                font_size: 15px;
                                font_weight: 800;
                                color: #FFFFFF;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }

                        Text {
                            text: "AURI";
                            font_size: 18px;
                            font_weight: 800;
                            letter_spacing: 1.2px;
                            color: #FFFFFF;
                            vertical_alignment: center;
                        }

                        Rectangle {
                            width: 44px;
                            height: 18px;
                            border-radius: 9px;
                            background: Theme.badge_bg;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: "1.0.1";
                                font_size: 10px;
                                font_weight: 600;
                                color: Theme.badge_text;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Navigation Menu
                    VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "LIBRARY";
                            font_size: 11px;
                            font_weight: 700;
                            letter_spacing: 0.8px;
                            color: Theme.text_muted;
                        }

                        AuriNavButton {
                            icon_source: @image-url("../assets/icons/music.svg");
                            label: "Home";
                            is_selected: root.current_nav == "home";
                            tooltip: "Home (Featured & Quick Picks)";
                            clicked => { root.navigate("home"); }
                        }
                        AuriNavButton {
                            icon_source: @image-url("../assets/icons/search.svg");
                            label: "Search";
                            is_selected: root.current_nav == "search";
                            tooltip: "YouTube Music & Local Search";
                            clicked => { root.navigate("search"); }
                        }
                        AuriNavButton {
                            icon_source: @image-url("../assets/icons/album.svg");
                            label: "Albums";
                            is_selected: root.current_nav == "albums";
                            tooltip: "Music Albums";
                            clicked => { root.navigate("albums"); }
                        }
                        AuriNavButton {
                            icon_source: @image-url("../assets/icons/folder.svg");
                            label: "Local Files";
                            badge: "482";
                            is_selected: root.current_nav == "local";
                            tooltip: "Scanned Local Audio Files";
                            clicked => { root.navigate("local"); }
                        }
                        AuriNavButton {
                            icon_source: @image-url("../assets/icons/heart.svg");
                            label: "Favorites";
                            is_selected: root.current_nav == "favorites";
                            tooltip: "Starred & Favorite Tracks";
                            clicked => { root.navigate("favorites"); }
                        }
                        AuriNavButton {
                            icon_source: @image-url("../assets/icons/queue.svg");
                            label: "Playlists";
                            is_selected: root.current_nav == "playlists";
                            tooltip: "Custom Playlists";
                            clicked => { root.navigate("playlists"); }
                        }
                    }

                    // Spacer
                    Rectangle { vertical_stretch: 1; }

                    // System Performance Pill & RAM Optimization
                    Rectangle {
                        height: 70px;
                        border-radius: Theme.radius_md;
                        background: Theme.bg_surface;
                        border-width: 1px;
                        border-color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                Text {
                                    text: "RAM COMMITTED";
                                    font_size: 9px;
                                    font_weight: 700;
                                    letter_spacing: 0.5px;
                                    color: Theme.text_muted;
                                    horizontal_stretch: 1;
                                    vertical_alignment: center;
                                }

                                Text {
                                    text: root.ram_usage;
                                    font_size: 11px;
                                    font_weight: 700;
                                    color: #10B981;
                                    vertical_alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: trim_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated;

                                    trim_touch := TouchArea {
                                        clicked => { root.trim_ram(); }
                                    }

                                    Text {
                                        text: "Trim Working Set";
                                        font_size: 10px;
                                        font_weight: 600;
                                        color: Theme.text_secondary;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Settings Button
                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/settings.svg");
                        label: "Settings";
                        is_selected: root.current_nav == "settings";
                        tooltip: "App & Performance Preferences";
                        clicked => { root.navigate("settings"); }
                    }
                }
            }

            // ==========================================
            // CENTER CONTENT: SLEEK APPLE/YOUTUBE MUSIC
            // ==========================================
            Rectangle {
                horizontal_stretch: 1;
                background: Theme.bg_app;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // Top Bar (Search + Volume + Fast Mode Switchers)
                    HorizontalLayout {
                        spacing: 14px;
                        height: 40px;

                        // Clickable Search Bar
                        search_box := Rectangle {
                            horizontal_stretch: 1;
                            height: 38px;
                            border-radius: Theme.radius_pill;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: search_input.has_focus ? Theme.accent : Theme.border_subtle;
                            animate border-color { duration: 120ms; }

                            // Entire container touch area forwards focus
                            TouchArea {
                                clicked => { search_input.focus(); }
                            }

                            HorizontalLayout {
                                padding_left: 14px;
                                padding_right: 14px;
                                spacing: 10px;

                                Image {
                                    source: @image-url("../assets/icons/search.svg");
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                    colorize: search_input.has_focus ? Theme.accent : Theme.text_muted;
                                    y: (parent.height - self.height) / 2;
                                }

                                Rectangle {
                                    horizontal_stretch: 1;

                                    if search_input.text == "": Text {
                                        x: 0;
                                        width: 100%;
                                        height: 100%;
                                        text: "Search YouTube Music & local files (press Enter)...";
                                        font_size: 13px;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                    }

                                    search_input := TextInput {
                                        x: 0;
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.search_query;
                                        font_size: 13px;
                                        color: Theme.text_primary;
                                        vertical_alignment: center;
                                        accepted => {
                                            root.navigate("search");
                                            root.perform_search(self.text);
                                        }
                                    }
                                }

                                if search_input.text != "": AuriIconButton {
                                    icon_source: @image-url("../assets/icons/close.svg");
                                    icon_size: 12px;
                                    btn_size: 24px;
                                    tooltip: "Clear Search";
                                    clicked => {
                                        search_input.text = "";
                                        root.perform_search("");
                                    }
                                }
                            }
                        }

                        // Volume Control Slider
                        HorizontalLayout {
                            spacing: 8px;
                            width: 130px;
                            alignment: center;

                            AuriIconButton {
                                icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                                icon_size: 16px;
                                btn_size: 28px;
                                tooltip: root.volume == 0.0 ? "Unmute Volume" : "Mute Volume";
                                clicked => {
                                    if (root.volume > 0.0) {
                                        root.volume_changed(0.0);
                                    } else {
                                        root.volume_changed(0.75);
                                    }
                                }
                            }

                            AuriSlider {
                                value: root.volume;
                                horizontal_stretch: 1;
                                value_changed(val) => { root.volume_changed(val); }
                            }
                        }

                        // Fast Mode Switchers
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            // Mini Mode Switch
                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/mini.svg");
                                icon_size: 16px;
                                btn_size: 32px;
                                tooltip: "Switch to Floating Mini Player (Ref 2)";
                                clicked => { root.switch_to_mini(); }
                            }

                            // Gaming HUD Switch
                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/gamepad.svg");
                                icon_size: 16px;
                                btn_size: 32px;
                                tooltip: "Switch to Gaming HUD (Ultra-Low RAM)";
                                clicked => { root.switch_to_gaming(); }
                            }
                        }
                    }

                    // Content Viewport: HOME VIEW (Clean Apple / YouTube Music Simplicity)
                    if root.current_nav == "home": VerticalLayout {
                        spacing: 20px;
                        vertical_stretch: 1;

                        // Quick Picks / Popular Tracks Table (Clean, sleek rows)
                        VerticalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                Text {
                                    text: "Quick Picks & Trending";
                                    font_size: 18px;
                                    font_weight: 800;
                                    color: #FFFFFF;
                                    horizontal_stretch: 1;
                                    vertical_alignment: center;
                                }

                                Text {
                                    text: "Click any song to play instantly";
                                    font_size: 11px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }
                            }

                            // Songs Table
                            VerticalLayout {
                                spacing: 4px;

                                // Song Row 1
                                Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_md;
                                    background: row1_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    row1_touch := TouchArea {
                                        clicked => {
                                            root.play_stream_track("mock-1", "Saldo 0,7", "Taco Hemingway", 214);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Text { text: "1"; font_size: 13px; font_weight: 600; color: Theme.text_muted; width: 16px; vertical_alignment: center; }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #EC4899;
                                            clip: true;
                                            Text { text: "🎵"; font_size: 14px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text { text: "Saldo 0,7"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                            Text { text: "Taco Hemingway • Szprycer"; font_size: 11px; color: Theme.text_secondary; }
                                        }

                                        Text { text: "3:34"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play Saldo 0,7";
                                            clicked => {
                                                root.play_stream_track("mock-1", "Saldo 0,7", "Taco Hemingway", 214);
                                            }
                                        }
                                    }
                                }

                                // Song Row 2
                                Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_md;
                                    background: row2_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    row2_touch := TouchArea {
                                        clicked => {
                                            root.play_stream_track("mock-2", "Tamagotchi", "Taco Hemingway ft. Quebonafide", 198);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Text { text: "2"; font_size: 13px; font_weight: 600; color: Theme.text_muted; width: 16px; vertical_alignment: center; }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #8B5CF6;
                                            clip: true;
                                            Text { text: "🎵"; font_size: 14px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text { text: "Tamagotchi"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                            Text { text: "Taco Hemingway, Quebonafide • Soma 0,5"; font_size: 11px; color: Theme.text_secondary; }
                                        }

                                        Text { text: "3:18"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play Tamagotchi";
                                            clicked => {
                                                root.play_stream_track("mock-2", "Tamagotchi", "Taco Hemingway ft. Quebonafide", 198);
                                            }
                                        }
                                    }
                                }

                                // Song Row 3
                                Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_md;
                                    background: row3_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    row3_touch := TouchArea {
                                        clicked => {
                                            root.play_stream_track("mock-3", "Wszystko na niby", "Taco Hemingway", 222);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Text { text: "3"; font_size: 13px; font_weight: 600; color: Theme.text_muted; width: 16px; vertical_alignment: center; }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #10B981;
                                            clip: true;
                                            Text { text: "🎵"; font_size: 14px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text { text: "Wszystko na niby"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                            Text { text: "Taco Hemingway • Café Belga"; font_size: 11px; color: Theme.text_secondary; }
                                        }

                                        Text { text: "3:42"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play Wszystko na niby";
                                            clicked => {
                                                root.play_stream_track("mock-3", "Wszystko na niby", "Taco Hemingway", 222);
                                            }
                                        }
                                    }
                                }

                                // Song Row 4: Gemini (Elder)
                                Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_md;
                                    background: row4_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    row4_touch := TouchArea {
                                        clicked => {
                                            root.play_stream_track("mock-4", "Gemini", "Elder", 580);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Text { text: "4"; font_size: 13px; font_weight: 600; color: Theme.text_muted; width: 16px; vertical_alignment: center; }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: #F59E0B;
                                            clip: true;
                                            Text { text: "🎵"; font_size: 14px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text { text: "Gemini"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                            Text { text: "Elder • Dead Roots Stirring"; font_size: 11px; color: Theme.text_secondary; }
                                        }

                                        Text { text: "9:40"; font_size: 12px; color: Theme.text_muted; vertical_alignment: center; }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play Gemini";
                                            clicked => {
                                                root.play_stream_track("mock-4", "Gemini", "Elder", 580);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Featured Albums Row (Reference 1 style)
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Featured Albums";
                                font_size: 16px;
                                font_weight: 800;
                                color: #FFFFFF;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                // Album 1
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 110px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        Rectangle {
                                            height: 54px;
                                            border-radius: 6px;
                                            background: #3B82F6;
                                            clip: true;
                                            Text { text: "💿"; font_size: 20px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        Text { text: "Pocztówka z WWA"; font_size: 12px; font_weight: 700; color: #FFFFFF; overflow: elide; }
                                        Text { text: "2019 • 11 tracks"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                // Album 2
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 110px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        Rectangle {
                                            height: 54px;
                                            border-radius: 6px;
                                            background: #10B981;
                                            clip: true;
                                            Text { text: "💿"; font_size: 20px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        Text { text: "Café Belga"; font_size: 12px; font_weight: 700; color: #FFFFFF; overflow: elide; }
                                        Text { text: "2018 • 11 tracks"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                // Album 3
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 110px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        Rectangle {
                                            height: 54px;
                                            border-radius: 6px;
                                            background: #F59E0B;
                                            clip: true;
                                            Text { text: "💿"; font_size: 20px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        Text { text: "Szprycer"; font_size: 12px; font_weight: 700; color: #FFFFFF; overflow: elide; }
                                        Text { text: "2017 • 9 tracks"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }

                                // Album 4
                                Rectangle {
                                    horizontal_stretch: 1;
                                    height: 110px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        Rectangle {
                                            height: 54px;
                                            border-radius: 6px;
                                            background: #8B5CF6;
                                            clip: true;
                                            Text { text: "💿"; font_size: 20px; horizontal_alignment: center; vertical_alignment: center; }
                                        }

                                        Text { text: "Marmur"; font_size: 12px; font_weight: 700; color: #FFFFFF; overflow: elide; }
                                        Text { text: "2016 • 18 tracks"; font_size: 10px; color: Theme.text_muted; }
                                    }
                                }
                            }
                        }
                    }

                    // Content Viewport: SEARCH RESULTS VIEW
                    if root.current_nav == "search": VerticalLayout {
                        spacing: 14px;
                        vertical_stretch: 1;

                        HorizontalLayout {
                            Text {
                                text: root.search_query == "" ? "Search Music" : "Search Results for \"" + root.search_query + "\"";
                                font_size: 18px;
                                font_weight: 800;
                                color: #FFFFFF;
                                horizontal_stretch: 1;
                                vertical_alignment: center;
                            }

                            Text {
                                text: "Powered by Innertube & Local Engine";
                                font_size: 11px;
                                color: Theme.text_muted;
                                vertical_alignment: center;
                            }
                        }

                        // Search Results List
                        VerticalLayout {
                            spacing: 6px;

                            for track in root.search_results: Rectangle {
                                height: 50px;
                                border-radius: Theme.radius_md;
                                background: item_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                item_touch := TouchArea {
                                    clicked => {
                                        root.play_stream_track(track.id, track.title, track.artist, track.duration_secs);
                                    }
                                }

                                HorizontalLayout {
                                    padding_left: 14px;
                                    padding_right: 14px;
                                    spacing: 12px;
                                    alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/play.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: item_touch.has_hover ? Theme.accent : Theme.text_muted;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        alignment: center;
                                        spacing: 1px;

                                        Text {
                                            text: track.title;
                                            font_size: 13px;
                                            font_weight: 600;
                                            color: #FFFFFF;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: track.artist;
                                            font_size: 11px;
                                            color: Theme.text_secondary;
                                            overflow: elide;
                                        }
                                    }

                                    Text {
                                        text: track.duration;
                                        font_size: 12px;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Content Viewport: SETTINGS VIEW
                    if root.current_nav == "settings": VerticalLayout {
                        spacing: 16px;
                        vertical_stretch: 1;

                        Text {
                            text: "AURI Preferences";
                            font_size: 18px;
                            font_weight: 800;
                            color: #FFFFFF;
                        }

                        Rectangle {
                            height: 180px;
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                HorizontalLayout {
                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        Text { text: "Normal Mode Layout"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                        Text { text: "Switch between Embedded Right Queue (Ref 1) and Classic Docked Bottom Bar"; font_size: 11px; color: Theme.text_muted; }
                                    }

                                    AuriIconButton {
                                        icon_source: @image-url("../assets/icons/queue.svg");
                                        tooltip: "Embedded Right Queue";
                                        is_active: root.layout_variant == 0;
                                        clicked => { root.navigate("set_var_0"); }
                                    }
                                    AuriIconButton {
                                        icon_source: @image-url("../assets/icons/expand.svg");
                                        tooltip: "Classic Bottom Bar";
                                        is_active: root.layout_variant == 1;
                                        clicked => { root.navigate("set_var_1"); }
                                    }
                                }

                                HorizontalLayout {
                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        Text { text: "Gaming Mode Auto-Detection"; font_size: 13px; font_weight: 600; color: #FFFFFF; }
                                        Text { text: "Automatically trim RAM and drop GPU usage to 0% when games are running"; font_size: 11px; color: Theme.text_muted; }
                                    }

                                    AuriIconButton {
                                        icon_source: @image-url("../assets/icons/gamepad.svg");
                                        tooltip: "Toggle Game Auto-Detect";
                                        is_active: root.auto_game_mode;
                                        active_color: #10B981;
                                        clicked => { root.toggle_auto_game(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // RIGHT SIDEBAR: PLAY QUEUE (Reference 1 Style)
            // ==========================================
            if root.layout_variant == 0: Rectangle {
                width: 280px;
                background: Theme.bg_sidebar;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    // Header
                    HorizontalLayout {
                        Text {
                            text: "Play queue";
                            font_size: 16px;
                            font_weight: 800;
                            color: #FFFFFF;
                            horizontal_stretch: 1;
                            vertical_alignment: center;
                        }
                        Text {
                            text: "8 / 23";
                            font_size: 11px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }
                    }

                    // EMBEDDED NOW-PLAYING CARD (Exact Reference 1 Layout)
                    Rectangle {
                        height: 190px;
                        border-radius: Theme.radius_md;
                        background: Theme.bg_card;
                        border-width: 1px;
                        border-color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            // Circular Vinyl Artwork (Ref 1 signature)
                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 26px;
                                background: #EC4899;
                                x: (parent.width - self.width) / 2;
                                clip: true;

                                Text {
                                    text: "🎵";
                                    font_size: 20px;
                                    horizontal_alignment: center;
                                    vertical_alignment: center;
                                }
                            }

                            // Title & Subtitle
                            VerticalLayout {
                                spacing: 1px;
                                Text {
                                    text: root.track_title;
                                    font_size: 13px;
                                    font_weight: 700;
                                    color: #FFFFFF;
                                    horizontal_alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.track_artist;
                                    font_size: 11px;
                                    color: Theme.text_muted;
                                    horizontal_alignment: center;
                                    overflow: elide;
                                }
                            }

                            // Transport Controls with Vector Icons
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;

                                AuriIconButton {
                                    icon_source: root.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                                    icon_size: 14px;
                                    btn_size: 28px;
                                    is_active: root.is_favorite;
                                    active_color: Theme.favorite_active;
                                    tooltip: "Favorite";
                                    clicked => { root.toggle_favorite(); }
                                }
                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/prev.svg");
                                    icon_size: 14px;
                                    btn_size: 28px;
                                    tooltip: "Previous Track";
                                    shortcut: "Alt+Left";
                                    clicked => { root.prev_track(); }
                                }
                                AuriPlayButton {
                                    is_playing: root.is_playing;
                                    button_size: 32px;
                                    tooltip: root.is_playing ? "Pause" : "Play";
                                    shortcut: "Space";
                                    clicked => { root.toggle_play(); }
                                }
                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/next.svg");
                                    icon_size: 14px;
                                    btn_size: 28px;
                                    tooltip: "Next Track";
                                    shortcut: "Alt+Right";
                                    clicked => { root.next_track(); }
                                }
                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/shuffle.svg");
                                    icon_size: 14px;
                                    btn_size: 28px;
                                    is_active: root.is_shuffle;
                                    tooltip: "Shuffle";
                                    clicked => { root.toggle_shuffle(); }
                                }
                            }

                            // Seekbar
                            VerticalLayout {
                                spacing: 2px;

                                AuriSlider {
                                    value: root.track_progress;
                                    value_changed(val) => { root.seek(val); }
                                }

                                HorizontalLayout {
                                    Text { text: root.track_elapsed; font_size: 9px; color: Theme.text_muted; }
                                    Rectangle { horizontal_stretch: 1; }
                                    Text { text: root.track_duration; font_size: 9px; color: Theme.text_muted; }
                                }
                            }
                        }
                    }

                    // Upcoming Queue Header
                    Text {
                        text: "NEXT UP";
                        font_size: 10px;
                        font_weight: 700;
                        letter_spacing: 0.8px;
                        color: Theme.text_muted;
                    }

                    // Queue Items
                    VerticalLayout {
                        spacing: 6px;
                        vertical_stretch: 1;

                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius_sm;
                            background: Theme.bg_surface;
                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                spacing: 10px;
                                alignment: center;
                                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: #6366F1; clip: true; }
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    Text { text: "all the good girls go to hell"; font_size: 11px; font_weight: 600; color: #FFFFFF; overflow: elide; }
                                    Text { text: "Billie Eilish"; font_size: 9px; color: Theme.text_muted; }
                                }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius_sm;
                            background: Theme.bg_surface;
                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                spacing: 10px;
                                alignment: center;
                                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: #EAB308; clip: true; }
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    Text { text: "COPYCAT"; font_size: 11px; font_weight: 600; color: #FFFFFF; overflow: elide; }
                                    Text { text: "Billie Eilish"; font_size: 9px; color: Theme.text_muted; }
                                }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius_sm;
                            background: Theme.bg_surface;
                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                spacing: 10px;
                                alignment: center;
                                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: #EC4899; clip: true; }
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    Text { text: "900729"; font_size: 11px; font_weight: 600; color: #FFFFFF; overflow: elide; }
                                    Text { text: "Taco Hemingway"; font_size: 9px; color: Theme.text_muted; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // DOCKED BOTTOM BAR (Variant A2 Alternative)
        // ==========================================
        if root.layout_variant == 1: Rectangle {
            height: 68px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_subtle;

            HorizontalLayout {
                padding_left: 16px;
                padding_right: 16px;
                spacing: 20px;

                // Left: Track Info & Heart
                HorizontalLayout {
                    width: 220px;
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: Theme.radius_sm;
                        background: #EC4899;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "🎵";
                            font_size: 18px;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal_stretch: 1;

                        Text {
                            text: root.track_title;
                            font_size: 13px;
                            font_weight: 700;
                            color: #FFFFFF;
                            overflow: elide;
                        }
                        Text {
                            text: root.track_artist;
                            font_size: 11px;
                            color: Theme.text_muted;
                            overflow: elide;
                        }
                    }

                    AuriIconButton {
                        icon_source: root.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                        icon_size: 15px;
                        btn_size: 28px;
                        is_active: root.is_favorite;
                        active_color: Theme.favorite_active;
                        tooltip: "Favorite";
                        clicked => { root.toggle_favorite(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Center: Transport Controls & Seekbar
                VerticalLayout {
                    horizontal_stretch: 1;
                    alignment: center;
                    spacing: 4px;

                    // Transport Buttons
                    HorizontalLayout {
                        alignment: center;
                        spacing: 16px;

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/shuffle.svg");
                            icon_size: 14px;
                            btn_size: 28px;
                            is_active: root.is_shuffle;
                            tooltip: "Shuffle";
                            clicked => { root.toggle_shuffle(); }
                        }
                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/prev.svg");
                            icon_size: 14px;
                            btn_size: 28px;
                            tooltip: "Previous Track";
                            shortcut: "Alt+Left";
                            clicked => { root.prev_track(); }
                        }
                        AuriPlayButton {
                            is_playing: root.is_playing;
                            button_size: 32px;
                            tooltip: root.is_playing ? "Pause" : "Play";
                            shortcut: "Space";
                            clicked => { root.toggle_play(); }
                        }
                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/next.svg");
                            icon_size: 14px;
                            btn_size: 28px;
                            tooltip: "Next Track";
                            shortcut: "Alt+Right";
                            clicked => { root.next_track(); }
                        }
                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/repeat.svg");
                            icon_size: 14px;
                            btn_size: 28px;
                            is_active: root.is_repeat;
                            tooltip: "Repeat";
                            clicked => { root.toggle_repeat(); }
                        }
                    }

                    // Seek Slider with Timestamps
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.track_elapsed;
                            font_size: 10px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }

                        AuriSlider {
                            value: root.track_progress;
                            value_changed(val) => { root.seek(val); }
                            horizontal_stretch: 1;
                        }

                        Text {
                            text: root.track_duration;
                            font_size: 10px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }
                    }
                }

                // Right: Volume & Fast Mode Switches
                HorizontalLayout {
                    width: 200px;
                    spacing: 10px;
                    alignment: end;

                    AuriIconButton {
                        icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                        icon_size: 14px;
                        btn_size: 28px;
                        tooltip: root.volume == 0.0 ? "Unmute Volume" : "Mute Volume";
                        clicked => {
                            if (root.volume > 0.0) {
                                root.volume_changed(0.0);
                            } else {
                                root.volume_changed(0.75);
                            }
                        }
                        y: (parent.height - self.height) / 2;
                    }

                    AuriSlider {
                        value: root.volume;
                        value_changed(val) => { root.volume_changed(val); }
                        width: 70px;
                    }

                    AuriIconButton {
                        icon_source: @image-url("../assets/icons/mini.svg");
                        icon_size: 14px;
                        btn_size: 28px;
                        tooltip: "Switch to Mini Mode";
                        clicked => { root.switch_to_mini(); }
                        y: (parent.height - self.height) / 2;
                    }

                    AuriIconButton {
                        icon_source: @image-url("../assets/icons/gamepad.svg");
                        icon_size: 14px;
                        btn_size: 28px;
                        tooltip: "Switch to Gaming HUD";
                        clicked => { root.switch_to_gaming(); }
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}
