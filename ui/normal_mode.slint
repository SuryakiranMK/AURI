// AURI Normal Mode View (Sleek Apple Music & Spotify Polish)
import { Theme } from "theme.slint";
import { TrackData, AlbumData, ArtistData } from "models.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider, AuriNavButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component NormalModeView inherits Rectangle {
    in property <string> current_nav: "home";
    in property <bool> is_playing: false;
    in property <string> track_title: "Midnight Drive";
    in property <string> track_artist: "The Cassettes";
    in property <string> track_album: "Synthwave Dreams";
    in property <string> track_duration: "3:34";
    in property <string> track_elapsed: "1:18";
    in property <float> track_progress: 0.36;
    in property <float> volume: 0.80;
    in property <bool> is_favorite: true;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in property <string> audio_engine_name: "Native WASAPI";
    in property <string> ram_usage: "28.5 MB";
    in-out property <string> search_query: "";
    in-out property <string> local_music_path: "C:\\Users\\user\\Music";
    in-out property <bool> loudness_norm_enabled: true;

    // Collections
    in-out property <[TrackData]> search_results: [];
    in-out property <[TrackData]> queue_tracks: [];
    in-out property <[TrackData]> home_tracks: [];
    in-out property <[AlbumData]> home_albums: [];
    in-out property <[TrackData]> local_tracks: [];
    in-out property <[TrackData]> favorite_tracks: [];
    in-out property <[AlbumData]> all_albums: [];
    in-out property <[ArtistData]> similar_artists: [];

    // Callbacks
    callback navigate(string);
    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_track_favorite(string);
    callback toggle_shuffle();
    callback toggle_repeat();
    callback switch_to_mini();
    callback switch_to_gaming();
    callback trim_ram();
    callback perform_search(string);
    callback play_track(string, string, string, int);
    callback switch_audio_engine(int);
    callback rescan_local(string);
    callback play_album(string);
    callback toggle_loudness(bool);

    background: Theme.bg_app;

    HorizontalLayout {
        // ==========================================
        // 1. LEFT SIDEBAR: SLEEK NAVIGATION
        // ==========================================
        Rectangle {
            width: 220px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_subtle;

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // Brand Header (AURI)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Theme.radius_md;
                        background: @linear-gradient(135deg, #6366F1 0%, #EC4899 100%);

                        Text {
                            text: "A";
                            font_size: 16px;
                            font_weight: 800;
                            color: #FFFFFF;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }

                    Text {
                        text: "AURI";
                        font_size: 18px;
                        font_weight: 800;
                        letter_spacing: 1.2px;
                        color: #FFFFFF;
                        vertical_alignment: center;
                    }

                    Rectangle {
                        width: 52px;
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.badge_bg;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "v0.2.0";
                            font_size: 10px;
                            font_weight: 600;
                            color: Theme.badge_text;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }
                }

                // Navigation Menu
                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "LIBRARY";
                        font_size: 11px;
                        font_weight: 700;
                        letter_spacing: 0.8px;
                        color: Theme.text_muted;
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/music.svg");
                        label: "Home";
                        is_selected: root.current_nav == "home";
                        tooltip: "Featured & Quick Picks";
                        clicked => { root.navigate("home"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/search.svg");
                        label: "Search";
                        is_selected: root.current_nav == "search";
                        tooltip: "Search YouTube Music & Local";
                        clicked => { root.navigate("search"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/album.svg");
                        label: "Albums";
                        is_selected: root.current_nav == "albums";
                        tooltip: "Albums Collection";
                        clicked => { root.navigate("albums"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/folder.svg");
                        label: "Local Files";
                        is_selected: root.current_nav == "local";
                        tooltip: "Local Audio Files";
                        clicked => { root.navigate("local"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/heart.svg");
                        label: "Favorites";
                        is_selected: root.current_nav == "favorites";
                        tooltip: "Starred Songs";
                        clicked => { root.navigate("favorites"); }
                    }
                }

                // Spacer
                Rectangle { vertical_stretch: 1; }

                // Live RAM Working Set & Purge Card
                Rectangle {
                    height: 64px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface;
                    border-width: 1px;
                    border-color: Theme.border_subtle;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            Text {
                                text: "WORKING SET (RAM)";
                                font_size: 9px;
                                font_weight: 700;
                                color: Theme.text_muted;
                                horizontal_stretch: 1;
                            }
                            Text {
                                text: root.ram_usage;
                                font_size: 11px;
                                font_weight: 700;
                                color: #34D399; // Emerald green
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: trim_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated;

                            trim_touch := TouchArea {
                                clicked => { root.trim_ram(); }
                            }

                            Text {
                                text: "Purge Working Set";
                                font_size: 10px;
                                font_weight: 600;
                                color: Theme.text_secondary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Preferences
                AuriNavButton {
                    icon_source: @image-url("../assets/icons/settings.svg");
                    label: "Settings";
                    is_selected: root.current_nav == "settings";
                    tooltip: "Audio Engine & Preferences";
                    clicked => { root.navigate("settings"); }
                }
            }
        }

        // ==========================================
        // 2. CENTER CONTENT VIEWPORT
        // ==========================================
        Rectangle {
            horizontal_stretch: 1;
            background: Theme.bg_app;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                // Top Bar: Search + Engine Badge + Volume + Mode Switchers
                HorizontalLayout {
                    spacing: 14px;
                    height: 38px;

                    // Clickable Search Bar
                    Rectangle {
                        horizontal_stretch: 1;
                        height: 38px;
                        border-radius: Theme.radius_pill;
                        background: Theme.bg_surface;
                        border-width: 1px;
                        border-color: search_input.has_focus ? Theme.accent : Theme.border_subtle;
                        animate border-color { duration: 120ms; }

                        TouchArea {
                            clicked => { search_input.focus(); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            spacing: 10px;

                            Image {
                                source: @image-url("../assets/icons/search.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: search_input.has_focus ? Theme.accent : Theme.text_muted;
                                y: (parent.height - self.height) / 2;
                            }

                            Rectangle {
                                horizontal_stretch: 1;

                                if search_input.text == "": Text {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text: "Search YouTube Music & local files (press Enter)...";
                                    font_size: 13px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }

                                search_input := TextInput {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.search_query;
                                    font_size: 13px;
                                    color: Theme.text_primary;
                                    vertical_alignment: center;
                                    accepted => {
                                        root.navigate("search");
                                        root.perform_search(self.text);
                                    }
                                }
                            }

                            if search_input.text != "": AuriIconButton {
                                icon_source: @image-url("../assets/icons/close.svg");
                                icon_size: 14px;
                                btn_size: 26px;
                                tooltip: "Clear Search";
                                clicked => {
                                    search_input.text = "";
                                    root.perform_search("");
                                }
                            }
                        }
                    }

                    // Active Audio Engine Badge
                    Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.bg_surface;
                        border-width: 1px;
                        border-color: Theme.border_elevated;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding_left: 10px;
                            padding_right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #10B981; // Active online green
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.audio_engine_name;
                                font_size: 11px;
                                font_weight: 600;
                                color: Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Volume Slider
                    HorizontalLayout {
                        spacing: 8px;
                        width: 120px;
                        alignment: center;

                        AuriIconButton {
                            icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                            icon_size: 16px;
                            btn_size: 28px;
                            tooltip: root.volume == 0.0 ? "Unmute" : "Mute";
                            clicked => {
                                if root.volume > 0.0 {
                                    root.volume_changed(0.0);
                                } else {
                                    root.volume_changed(0.8);
                                }
                            }
                        }

                        AuriSlider {
                            value: root.volume;
                            horizontal_stretch: 1;
                            value_changed(val) => { root.volume_changed(val); }
                        }
                    }

                    // Fast Mode Switchers
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/mini.svg");
                            icon_size: 16px;
                            btn_size: 32px;
                            tooltip: "Switch to Floating Mini Player (Ref 2)";
                            clicked => { root.switch_to_mini(); }
                        }

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/gamepad.svg");
                            icon_size: 16px;
                            btn_size: 32px;
                            tooltip: "Switch to Gaming Mode (0% GPU)";
                            clicked => { root.switch_to_gaming(); }
                        }
                    }
                }

                // ==========================================
                // MAIN SCROLLABLE CONTENT REGION
                // ==========================================
                ScrollView {
                    vertical_stretch: 1;

                    VerticalLayout {
                        padding_bottom: 20px;
                        spacing: 20px;

                        // ------------------------------------------
                        // VIEW 1: HOME VIEW (Ref 1 Polish)
                        // ------------------------------------------
                        if root.current_nav == "home": VerticalLayout {
                            spacing: 20px;

                            // Taco Hemingway / Featured Artist Hero (Ref 1 Exact Design)
                            HorizontalLayout {
                                spacing: 20px;
                                alignment: start;

                                Rectangle {
                                    width: 100px;
                                    height: 100px;
                                    border-radius: 50px;
                                    background: @linear-gradient(135deg, #F43F5E 0%, #8B5CF6 100%);
                                    border-width: 3px;
                                    border-color: #FFFFFF22;

                                    Text {
                                        text: "TH";
                                        font_size: 32px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: "Taco Hemingway";
                                        font_size: 28px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        Rectangle {
                                            width: 74px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_elevated;

                                            Text {
                                                text: "+ Follow";
                                                font_size: 11px;
                                                font_weight: 600;
                                                color: Theme.text_primary;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            width: 90px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: Theme.accent;

                                            TouchArea {
                                                clicked => { root.toggle_play(); }
                                            }

                                            Text {
                                                text: root.is_playing ? "⏸ Pause" : "▶ Play All";
                                                font_size: 11px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Albums Section (Ref 1 Horizontal Row)
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    Text {
                                        text: "Albums";
                                        font_size: 17px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                        horizontal_stretch: 1;
                                    }
                                    Text {
                                        text: "Sort by Year ▼";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    for album in root.home_albums: Rectangle {
                                        horizontal_stretch: 1;
                                        height: 168px;
                                        border-radius: Theme.radius_md;
                                        background: album_item_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                        border-width: 1px;
                                        border-color: Theme.border_subtle;

                                        album_item_touch := TouchArea {
                                            clicked => { root.play_album(album.id); }
                                        }

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 8px;

                                            Rectangle {
                                                height: 94px;
                                                border-radius: 6px;
                                                background: album.color_hue;
                                                clip: true;

                                                Text {
                                                    text: "💿";
                                                    font_size: 32px;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }

                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: album.title;
                                                    font_size: 12px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: album.year;
                                                    font_size: 10px;
                                                    color: Theme.text_secondary;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Popular Tracks & Similar Artists Columns (Ref 1 Two-Column Section)
                            HorizontalLayout {
                                spacing: 24px;

                                // Popular Tracks List
                                VerticalLayout {
                                    horizontal_stretch: 3;
                                    spacing: 8px;

                                    Text {
                                        text: "Popular";
                                        font_size: 17px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    VerticalLayout {
                                        spacing: 4px;

                                        for track[idx] in root.home_tracks: Rectangle {
                                            height: 48px;
                                            border-radius: Theme.radius_md;
                                            background: pop_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;

                                            pop_touch := TouchArea {
                                                clicked => {
                                                    root.play_track(track.id, track.title, track.artist, 214);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding_left: 12px;
                                                padding_right: 12px;
                                                spacing: 12px;
                                                alignment: center;

                                                Text {
                                                    text: idx + 1;
                                                    font_size: 12px;
                                                    font_weight: 600;
                                                    color: Theme.text_muted;
                                                    width: 14px;
                                                    vertical_alignment: center;
                                                }

                                                Rectangle {
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 6px;
                                                    background: track.color_hue;

                                                    Text {
                                                        text: "🎵";
                                                        font_size: 12px;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text {
                                                        text: track.title;
                                                        font_size: 13px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: track.artist;
                                                        font_size: 11px;
                                                        color: Theme.text_secondary;
                                                        overflow: elide;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 44px;
                                                    height: 18px;
                                                    border-radius: 4px;
                                                    background: Theme.badge_bg;
                                                    y: (parent.height - self.height) / 2;

                                                    Text {
                                                        text: track.format_badge;
                                                        font_size: 9px;
                                                        font_weight: 700;
                                                        color: Theme.badge_text;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: track.duration;
                                                    font_size: 11px;
                                                    color: Theme.text_muted;
                                                    vertical_alignment: center;
                                                }

                                                AuriIconButton {
                                                    icon_source: track.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                                                    icon_size: 14px;
                                                    btn_size: 26px;
                                                    active_color: Theme.favorite_active;
                                                    is_active: track.is_favorite;
                                                    tooltip: "Favorite";
                                                    clicked => { root.toggle_track_favorite(track.id); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Similar Artists Column (Ref 1)
                                VerticalLayout {
                                    horizontal_stretch: 2;
                                    spacing: 8px;

                                    Text {
                                        text: "Similar Artist";
                                        font_size: 17px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    VerticalLayout {
                                        spacing: 8px;

                                        for artist in root.similar_artists: Rectangle {
                                            height: 54px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.bg_surface;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;

                                            HorizontalLayout {
                                                padding_left: 12px;
                                                padding_right: 12px;
                                                spacing: 12px;
                                                alignment: center;

                                                Rectangle {
                                                    width: 36px;
                                                    height: 36px;
                                                    border-radius: 18px;
                                                    background: artist.color_hue;

                                                    Text {
                                                        text: "👤";
                                                        font_size: 14px;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text {
                                                        text: artist.name;
                                                        font_size: 12px;
                                                        font_weight: 700;
                                                        color: #FFFFFF;
                                                    }
                                                    Text {
                                                        text: artist.role;
                                                        font_size: 10px;
                                                        color: Theme.text_secondary;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 60px;
                                                    height: 22px;
                                                    border-radius: 11px;
                                                    background: Theme.bg_surface_elevated;

                                                    Text {
                                                        text: "+ Follow";
                                                        font_size: 10px;
                                                        font_weight: 600;
                                                        color: Theme.text_secondary;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 2: SEARCH VIEW
                        // ------------------------------------------
                        if root.current_nav == "search": VerticalLayout {
                            spacing: 14px;

                            Text {
                                text: root.search_query != "" ? "Search Results for \"" + root.search_query + "\"" : "Search YouTube Music & Local Catalog";
                                font_size: 18px;
                                font_weight: 800;
                                color: #FFFFFF;
                            }

                            if root.search_results.length == 0: Rectangle {
                                height: 160px;
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: "🔍";
                                        font_size: 32px;
                                        horizontal_alignment: center;
                                    }
                                    Text {
                                        text: root.search_query == "" ? "Type any song, artist or album name above and press Enter." : "No tracks found for \"" + root.search_query + "\".";
                                        font_size: 13px;
                                        color: Theme.text_secondary;
                                        horizontal_alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;

                                for res[idx] in root.search_results: Rectangle {
                                    height: 52px;
                                    border-radius: Theme.radius_md;
                                    background: search_row_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    search_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(res.id, res.title, res.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 6px;
                                            background: res.color_hue;
                                            clip: true;

                                            Text {
                                                text: "🎵";
                                                font_size: 16px;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: res.title;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: res.artist + " • " + res.album;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 68px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            y: (parent.height - self.height) / 2;

                                            Text {
                                                text: res.format_badge;
                                                font_size: 10px;
                                                font_weight: 700;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Text {
                                            text: res.duration;
                                            font_size: 12px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 16px;
                                            btn_size: 30px;
                                            tooltip: "Play Result";
                                            clicked => {
                                                root.play_track(res.id, res.title, res.artist, 200);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 3: ALBUMS VIEW
                        // ------------------------------------------
                        if root.current_nav == "albums": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                Text {
                                    text: "Albums Collection";
                                    font_size: 18px;
                                    font_weight: 800;
                                    color: #FFFFFF;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: root.all_albums.length + " Albums in Library";
                                    font_size: 12px;
                                    color: Theme.text_muted;
                                }
                            }

                            // 4-Column Grid for Albums
                            HorizontalLayout {
                                spacing: 16px;

                                for alb in root.all_albums: Rectangle {
                                    horizontal_stretch: 1;
                                    height: 190px;
                                    border-radius: Theme.radius_md;
                                    background: alb_card_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    alb_card_touch := TouchArea {
                                        clicked => { root.play_album(alb.id); }
                                    }

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;

                                        Rectangle {
                                            height: 110px;
                                            border-radius: 8px;
                                            background: alb.color_hue;

                                            Text {
                                                text: "💿";
                                                font_size: 40px;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: alb.title;
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: alb.artist + " (" + alb.year + ")";
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 4: LOCAL FILES VIEW
                        // ------------------------------------------
                        if root.current_nav == "local": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Local Music Library";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }
                                    Text {
                                        text: "Scanning path: " + root.local_music_path;
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                Rectangle {
                                    width: 120px;
                                    height: 32px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.bg_surface_elevated;
                                    border-width: 1px;
                                    border-color: Theme.border_elevated;

                                    TouchArea {
                                        clicked => { root.rescan_local(root.local_music_path); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Text {
                                            text: "🔄 Rescan Folder";
                                            font_size: 11px;
                                            font_weight: 600;
                                            color: #FFFFFF;
                                            vertical_alignment: center;
                                        }
                                    }
                                }
                            }

                            if root.local_tracks.length == 0: Rectangle {
                                height: 160px;
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: "📁";
                                        font_size: 32px;
                                        horizontal_alignment: center;
                                    }
                                    Text {
                                        text: "No audio files detected in local folder.";
                                        font_size: 13px;
                                        color: #FFFFFF;
                                        horizontal_alignment: center;
                                    }
                                    Text {
                                        text: "Place FLAC, MP3, WAV or AAC files in " + root.local_music_path + " and click Rescan.";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                        horizontal_alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;

                                for ltrack[idx] in root.local_tracks: Rectangle {
                                    height: 50px;
                                    border-radius: Theme.radius_md;
                                    background: local_row_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    local_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(ltrack.id, ltrack.title, ltrack.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 16px;
                                            vertical_alignment: center;
                                        }

                                        Rectangle {
                                            width: 34px;
                                            height: 34px;
                                            border-radius: 6px;
                                            background: ltrack.color_hue;

                                            Text {
                                                text: "🎵";
                                                font_size: 14px;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: ltrack.title;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ltrack.artist + " • " + ltrack.album;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 56px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            y: (parent.height - self.height) / 2;

                                            Text {
                                                text: ltrack.format_badge;
                                                font_size: 9px;
                                                font_weight: 700;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Text {
                                            text: ltrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play " + ltrack.title;
                                            clicked => {
                                                root.play_track(ltrack.id, ltrack.title, ltrack.artist, 200);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 5: FAVORITES VIEW
                        // ------------------------------------------
                        if root.current_nav == "favorites": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Favorite Tracks";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }
                                    Text {
                                        text: root.favorite_tracks.length + " Starred Songs";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                Rectangle {
                                    width: 90px;
                                    height: 32px;
                                    border-radius: Theme.radius_md;
                                    background: Theme.accent;

                                    TouchArea {
                                        clicked => {
                                            if root.favorite_tracks.length > 0 {
                                                root.play_track(root.favorite_tracks[0].id, root.favorite_tracks[0].title, root.favorite_tracks[0].artist, 200);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Text {
                                            text: "▶ Play All";
                                            font_size: 12px;
                                            font_weight: 700;
                                            color: #FFFFFF;
                                            vertical_alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;

                                for ftrack[idx] in root.favorite_tracks: Rectangle {
                                    height: 50px;
                                    border-radius: Theme.radius_md;
                                    background: fav_row_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;

                                    fav_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(ftrack.id, ftrack.title, ftrack.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 14px;
                                        padding_right: 14px;
                                        spacing: 14px;
                                        alignment: center;

                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 16px;
                                            vertical_alignment: center;
                                        }

                                        Rectangle {
                                            width: 34px;
                                            height: 34px;
                                            border-radius: 6px;
                                            background: ftrack.color_hue;

                                            Text {
                                                text: "🎵";
                                                font_size: 14px;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: ftrack.title;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ftrack.artist + " • " + ftrack.album;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 50px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            y: (parent.height - self.height) / 2;

                                            Text {
                                                text: ftrack.format_badge;
                                                font_size: 9px;
                                                font_weight: 700;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Text {
                                            text: ftrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/heart-filled.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            active_color: Theme.favorite_active;
                                            is_active: true;
                                            tooltip: "Remove from Favorites";
                                            clicked => { root.toggle_track_favorite(ftrack.id); }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 6: SETTINGS VIEW
                        // ------------------------------------------
                        if root.current_nav == "settings": VerticalLayout {
                            spacing: 18px;

                            Text {
                                text: "Audio Engine & Preferences";
                                font_size: 18px;
                                font_weight: 800;
                                color: #FFFFFF;
                            }

                            // 1. Dual-Engine Switcher
                            Rectangle {
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                height: 180px;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 12px;

                                    Text {
                                        text: "AUDIO ENGINE SELECTION (Toggle Live)";
                                        font_size: 11px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 70px;
                                            border-radius: Theme.radius_md;
                                            background: eng1_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: root.audio_engine_name == "Native WASAPI" ? Theme.accent : Theme.border_subtle;

                                            eng1_touch := TouchArea {
                                                clicked => { root.switch_audio_engine(0); }
                                            }

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 4px;
                                                Text {
                                                    text: "⚡ Native WASAPI Engine (Gaming Recommended)";
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                }
                                                Text {
                                                    text: "Pure Rust Symphonia + Cubic Resampler. < 35 MB RAM, 0% GPU, MMCSS priority.";
                                                    font_size: 11px;
                                                    color: Theme.text_secondary;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 70px;
                                            border-radius: Theme.radius_md;
                                            background: eng2_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: root.audio_engine_name != "Native WASAPI" ? Theme.accent : Theme.border_subtle;

                                            eng2_touch := TouchArea {
                                                clicked => { root.switch_audio_engine(1); }
                                            }

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 4px;
                                                Text {
                                                    text: "🎛️ Studio libmpv Engine (Audiophile)";
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                }
                                                Text {
                                                    text: "C libmpv backend with gapless lookahead deck, crossfade, and Soxr Sinc resampling.";
                                                    font_size: 11px;
                                                    color: Theme.text_secondary;
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Dual-Engine architecture guarantees studio playback fidelity without sacrificing gaming FPS.";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }
                            }

                            // 2. Loudness Normalization & MMCSS Details
                            Rectangle {
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                height: 130px;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;

                                    Text {
                                        text: "AUDIO FIDELITY & DYNAMICS PROCESSING";
                                        font_size: 11px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: "YouTube Music -7.0 LUFS Target Normalization & Peak Limiter";
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                            }
                                            Text {
                                                text: "Extracts loudnessDb and applies continuous gain scaling with soft-knee limiter.";
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                            }
                                        }

                                        Rectangle {
                                            width: 44px;
                                            height: 24px;
                                            border-radius: 12px;
                                            background: root.loudness_norm_enabled ? Theme.accent : Theme.border_elevated;

                                            TouchArea {
                                                clicked => { root.toggle_loudness(!root.loudness_norm_enabled); }
                                            }

                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #FFFFFF;
                                                x: root.loudness_norm_enabled ? parent.width - self.width - 3px : 3px;
                                                y: 3px;
                                                animate x { duration: 120ms; }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "MMCSS Scheduling:";
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                        }
                                        Text {
                                            text: "AvSetMmThreadCharacteristicsW(\"Audio\") Active (Zero dropouts during 100% CPU loads)";
                                            font_size: 11px;
                                            font_weight: 600;
                                            color: #34D399;
                                        }
                                    }
                                }
                            }

                            // 3. Local Music Folder Path Settings
                            Rectangle {
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                height: 110px;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;

                                    Text {
                                        text: "LOCAL MUSIC DIRECTORY";
                                        font_size: 11px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 36px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_elevated;

                                            HorizontalLayout {
                                                padding_left: 12px;
                                                padding_right: 12px;
                                                TextInput {
                                                    text <=> root.local_music_path;
                                                    font_size: 12px;
                                                    color: #FFFFFF;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 100px;
                                            height: 36px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.accent;

                                            TouchArea {
                                                clicked => { root.rescan_local(root.local_music_path); }
                                            }

                                            Text {
                                                text: "Scan Path";
                                                font_size: 12px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // 3. RIGHT PANEL: PLAY QUEUE & NOW PLAYING (Ref 1)
        // ==========================================
        Rectangle {
            width: 290px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_subtle;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Play queue";
                        font_size: 16px;
                        font_weight: 800;
                        color: #FFFFFF;
                        horizontal_stretch: 1;
                    }
                    Text {
                        text: root.queue_tracks.length + " Tracks";
                        font_size: 11px;
                        color: Theme.text_muted;
                        vertical_alignment: center;
                    }
                }

                // Reference 1 Now Playing Card
                Rectangle {
                    height: 220px;
                    border-radius: Theme.radius_lg;
                    background: Theme.bg_card;
                    border-width: 1px;
                    border-color: Theme.border_elevated;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        alignment: center;

                        // Circular Artwork with Vinyl Record Motif
                        Rectangle {
                            width: 60px;
                            height: 60px;
                            border-radius: 30px;
                            background: @linear-gradient(135deg, #EC4899 0%, #8B5CF6 100%);
                            border-width: 2px;
                            border-color: #FFFFFF33;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: #0E0F14;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        // Track Title & Artist
                        VerticalLayout {
                            spacing: 1px;
                            alignment: center;
                            Text {
                                text: root.track_title;
                                font_size: 14px;
                                font_weight: 700;
                                color: #FFFFFF;
                                horizontal_alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.track_artist;
                                font_size: 11px;
                                color: Theme.text_secondary;
                                horizontal_alignment: center;
                                overflow: elide;
                            }
                        }

                        // Seekbar & Time
                        VerticalLayout {
                            spacing: 3px;

                            AuriSlider {
                                value: root.track_progress;
                                value_changed(val) => { root.seek(val); }
                            }

                            HorizontalLayout {
                                Text {
                                    text: root.track_elapsed;
                                    font_size: 10px;
                                    color: Theme.text_muted;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: root.track_duration;
                                    font_size: 10px;
                                    color: Theme.text_muted;
                                }
                            }
                        }

                        // Transport Controls (Ref 1 Exact Layout)
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/shuffle.svg");
                                icon_size: 14px;
                                btn_size: 26px;
                                is_active: root.is_shuffle;
                                tooltip: "Shuffle";
                                clicked => { root.toggle_shuffle(); }
                            }

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/prev.svg");
                                icon_size: 16px;
                                btn_size: 28px;
                                tooltip: "Previous";
                                clicked => { root.prev_track(); }
                            }

                            AuriPlayButton {
                                button_size: 38px;
                                is_playing: root.is_playing;
                                clicked => { root.toggle_play(); }
                            }

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/next.svg");
                                icon_size: 16px;
                                btn_size: 28px;
                                tooltip: "Next";
                                clicked => { root.next_track(); }
                            }

                            AuriIconButton {
                                icon_source: @image-url("../assets/icons/repeat.svg");
                                icon_size: 14px;
                                btn_size: 26px;
                                is_active: root.is_repeat;
                                tooltip: "Repeat";
                                clicked => { root.toggle_repeat(); }
                            }
                        }
                    }
                }

                // Up Next Queue Header
                Text {
                    text: "Up Next";
                    font_size: 13px;
                    font_weight: 700;
                    color: Theme.text_muted;
                }

                // Up Next Items List (Scrollable)
                ScrollView {
                    vertical_stretch: 1;

                    VerticalLayout {
                        spacing: 4px;

                        for qtrack in root.queue_tracks: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius_md;
                            background: q_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface;

                            q_touch := TouchArea {
                                clicked => {
                                    root.play_track(qtrack.id, qtrack.title, qtrack.artist, 200);
                                }
                            }

                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                spacing: 10px;
                                alignment: center;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: qtrack.color_hue;
                                    clip: true;

                                    Text {
                                        text: "🎵";
                                        font_size: 12px;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: qtrack.title;
                                        font_size: 12px;
                                        font_weight: 600;
                                        color: #FFFFFF;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: qtrack.artist;
                                        font_size: 10px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: qtrack.duration;
                                    font_size: 11px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
