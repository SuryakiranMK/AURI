// AURI Normal Mode View (Apple-Grade Precision Table Alignment & Glassmorphism)
import { Theme } from "theme.slint";
import { TrackData, AlbumData, ArtistData } from "models.slint";
import { AuriIconButton, AuriPlayButton, AuriSlider, AuriNavButton, AuriTrackCard } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component NormalModeView inherits Rectangle {
    in property <string> current_nav: "home";
    in property <bool> is_playing: false;
    in property <string> track_title: "Midnight Drive";
    in property <string> track_artist: "The Cassettes";
    in property <string> track_album: "Synthwave Dreams";
    in property <string> track_duration: "3:34";
    in property <string> track_elapsed: "1:18";
    in property <float> track_progress: 0.36;
    in property <float> volume: 0.80;
    in property <bool> is_favorite: true;
    in property <bool> is_shuffle: false;
    in property <bool> is_repeat: false;
    in property <string> audio_engine_name: "Native WASAPI";
    in property <string> ram_usage: "28.5 MB";
    in-out property <string> search_query: "";
    in-out property <string> local_music_path: "C:\\Users\\user\\Music";
    in property <bool> loudness_norm_enabled: true;
    in property <image> artwork;
    in property <bool> has_artwork: false;
    in-out property <string> player_layout: "bottom"; // "bottom" (Tubefast default) or "sidebar"
    in-out property <bool> show_queue: true;
    in-out property <string> more_like_title: "More like Gehra Hua (From \"Dhurandhar\")";

    // Collections
    in-out property <[TrackData]> search_results: [];
    in-out property <[TrackData]> queue_tracks: [];
    in-out property <[TrackData]> home_tracks: [];
    in-out property <[AlbumData]> home_albums: [];
    in-out property <[TrackData]> local_tracks: [];
    in-out property <[TrackData]> favorite_tracks: [];
    in-out property <[TrackData]> recent_tracks: [];
    in-out property <[TrackData]> quick_picks_col1: [];
    in-out property <[TrackData]> quick_picks_col2: [];
    in-out property <[TrackData]> more_like_col1: [];
    in-out property <[TrackData]> more_like_col2: [];
    in-out property <[AlbumData]> all_albums: [];
    in-out property <[ArtistData]> similar_artists: [];

    // Callbacks
    callback navigate(string);
    callback navigate_back();
    callback navigate_forward();
    callback toggle_play();
    callback prev_track();
    callback next_track();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_favorite();
    callback toggle_track_favorite(string);
    callback toggle_shuffle();
    callback toggle_repeat();
    callback switch_to_mini();
    callback switch_to_gaming();
    callback trim_ram();
    callback perform_search(string);
    callback search_edited(string);
    callback play_track(string, string, string, int);
    callback switch_audio_engine(int);
    callback rescan_local(string);
    callback play_album(string);
    callback toggle_loudness(bool);
    callback clear_history();
    callback play_all_recent();
    callback toggle_player_layout();
    callback toggle_queue();

    background: Theme.bg_app;

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            vertical_stretch: 1;

            // ==========================================
            // 1. LEFT SIDEBAR: STREAMLINED GLASS NAVIGATION
            // ==========================================
            Rectangle {
                width: 210px;
                background: Theme.bg_sidebar;
                border-width: 1px;
                border-color: Theme.border_glass;

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // Brand Header (AURI)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/brand_64.png");
                        width: 28px;
                        height: 28px;
                        image-fit: contain;
                    }

                    Text {
                        text: "AURI";
                        font_size: 17px;
                        font_weight: 800;
                        letter_spacing: 1.2px;
                        color: #FFFFFF;
                        vertical_alignment: center;
                    }

                    Rectangle {
                        width: 48px;
                        height: 18px;
                        border-radius: Theme.radius_pill;
                        background: Theme.badge_bg;
                        border-width: 1px;
                        border-color: Theme.badge_border;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "v0.2.2";
                            font_size: 9px;
                            font_weight: 700;
                            color: Theme.badge_text;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                    }
                }

                // Navigation Menu (Tubefast Layout)
                VerticalLayout {
                    spacing: 4px;

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/home.svg");
                        label: "Home";
                        is_selected: root.current_nav == "home";
                        tooltip: "Featured & Quick Picks";
                        clicked => { root.navigate("home"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/heart.svg");
                        label: "Liked songs";
                        is_selected: root.current_nav == "favorites";
                        badge: root.favorite_tracks.length > 0 ? (root.favorite_tracks.length + "") : "";
                        tooltip: "Starred & Liked Songs";
                        clicked => { root.navigate("favorites"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/history.svg");
                        label: "Recently played";
                        is_selected: root.current_nav == "recent";
                        badge: root.recent_tracks.length > 0 ? (root.recent_tracks.length + "") : "";
                        tooltip: "Recently Played Songs";
                        clicked => { root.navigate("recent"); }
                    }

                    // Section Divider
                    Rectangle { height: 8px; }

                    Text {
                        text: "LIBRARY";
                        font_size: 10px;
                        font_weight: 800;
                        letter_spacing: 1px;
                        color: Theme.text_muted;
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/search.svg");
                        label: "Search";
                        is_selected: root.current_nav == "search";
                        tooltip: "Search Catalog";
                        clicked => { root.navigate("search"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/album.svg");
                        label: "Albums";
                        is_selected: root.current_nav == "albums";
                        tooltip: "Albums Collection";
                        clicked => { root.navigate("albums"); }
                    }

                    AuriNavButton {
                        icon_source: @image-url("../assets/icons/folder.svg");
                        label: "Local Files";
                        is_selected: root.current_nav == "local";
                        tooltip: "Local Audio Files";
                        clicked => { root.navigate("local"); }
                    }
                }

                // Spacer
                Rectangle { vertical_stretch: 1; }

                // Live RAM Working Set & Purge Card
                Rectangle {
                    height: 64px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_glass;
                    border-width: 1px;
                    border-color: Theme.border_glass;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            Text {
                                text: "WORKING SET (RAM)";
                                font_size: 9px;
                                font_weight: 800;
                                letter_spacing: 0.6px;
                                color: Theme.text_muted;
                                horizontal_stretch: 1;
                            }
                            Text {
                                text: root.ram_usage;
                                font_size: 11px;
                                font_weight: 800;
                                color: Theme.success;
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 6px;
                            background: trim_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated;
                            border-width: 1px;
                            border-color: Theme.border_glass;

                            trim_touch := TouchArea {
                                clicked => { root.trim_ram(); }
                            }

                            Text {
                                text: "Purge Working Set";
                                font_size: 10px;
                                font_weight: 600;
                                color: Theme.text_secondary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                // Settings Navigation Button
                AuriNavButton {
                    icon_source: @image-url("../assets/icons/settings.svg");
                    label: "Settings";
                    is_selected: root.current_nav == "settings";
                    tooltip: "Audio Engine & Preferences";
                    clicked => { root.navigate("settings"); }
                }
            }
        }

        // ==========================================
        // 2. CENTER CONTENT VIEWPORT (WIDE & SPACIOUS)
        // ==========================================
        Rectangle {
            horizontal_stretch: 1;
            background: Theme.bg_app;

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // ------------------------------------------
                // TOP BAR: TUBEFAST SEARCH BAR (Image 1) + HISTORY + AUDIO ENGINE + MODES
                // ------------------------------------------
                HorizontalLayout {
                    spacing: 12px;
                    height: 40px;

                    // Navigation History Arrows (< and > matching Image 1)
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        y: (parent.height - self.height) / 2;

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/chevron-left.svg");
                            icon_size: 14px;
                            btn_size: 28px;
                            tooltip: "Back";
                            clicked => { root.navigate_back(); }
                        }

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/chevron-right.svg");
                            icon_size: 14px;
                            btn_size: 28px;
                            tooltip: "Forward";
                            clicked => { root.navigate_forward(); }
                        }
                    }

                    // Tubefast Precision Search Pill (Exact match to Image 1)
                    Rectangle {
                        min_width: 340px;
                        max_width: 540px;
                        horizontal_stretch: 1;
                        height: 38px;
                        border-radius: 19px;
                        background: #23222499;
                        border-width: 1px;
                        border-color: search_input.has_focus ? Theme.accent : #FFFFFF1C;
                        y: (parent.height - self.height) / 2;
                        animate border-color { duration: 150ms; }

                        TouchArea {
                            clicked => { search_input.focus(); }
                        }

                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 12px;
                            spacing: 10px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/search.svg");
                                width: 15px;
                                height: 15px;
                                image-fit: contain;
                                colorize: search_input.has_focus ? #FFFFFF : #9E9B9B;
                                y: (parent.height - self.height) / 2;
                            }

                            Rectangle {
                                horizontal_stretch: 1;

                                if search_input.text == "": Text {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text: "Search songs, albums, artists";
                                    font_size: 13px;
                                    color: #9E9B9B;
                                    vertical_alignment: center;
                                }

                                search_input := TextInput {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.search_query;
                                    font_size: 13px;
                                    color: #FFFFFF;
                                    vertical_alignment: center;
                                    edited => {
                                        root.search_edited(self.text);
                                    }
                                    accepted => {
                                        root.perform_search(self.text);
                                    }
                                }
                            }

                            // "Ctrl K" Shortcut Badge (Image 1)
                            if search_input.text == "": Rectangle {
                                width: 44px;
                                height: 20px;
                                border-radius: 4px;
                                background: #FFFFFF12;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: "Ctrl K";
                                    font_size: 10px;
                                    font_weight: 600;
                                    color: #9E9B9B;
                                    horizontal_alignment: center;
                                    vertical_alignment: center;
                                }
                            }

                            if search_input.text != "": AuriIconButton {
                                icon_source: @image-url("../assets/icons/close.svg");
                                icon_size: 12px;
                                btn_size: 22px;
                                y: (parent.height - self.height) / 2;
                                tooltip: "Clear Search";
                                clicked => {
                                    search_input.text = "";
                                    root.search_edited("");
                                }
                            }
                        }
                    }

                    Rectangle { horizontal_stretch: 1; }

                    // Active Audio Engine Glass Badge
                    Rectangle {
                        height: 30px;
                        border-radius: Theme.radius_pill;
                        background: Theme.bg_surface_glass;
                        border-width: 1px;
                        border-color: Theme.border_glass;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.success;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.audio_engine_name;
                                font_size: 11px;
                                font_weight: 700;
                                color: Theme.text_secondary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    // Volume Slider with Mute (Subpixel Center Aligned)
                    HorizontalLayout {
                        spacing: 6px;
                        width: 125px;
                        alignment: center;
                        y: (parent.height - self.height) / 2;

                        AuriIconButton {
                            icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                            icon_size: 15px;
                            btn_size: 26px;
                            y: (parent.height - self.height) / 2;
                            tooltip: root.volume == 0.0 ? "Unmute" : "Mute";
                            clicked => {
                                if root.volume > 0.0 {
                                    root.volume_changed(0.0);
                                } else {
                                    root.volume_changed(0.8);
                                }
                            }
                        }

                        AuriSlider {
                            width: 88px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            value: root.volume;
                            value_changed(val) => { root.volume_changed(val); }
                        }
                    }

                    // Fast Mode Switchers
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/mini.svg");
                            icon_size: 16px;
                            btn_size: 32px;
                            tooltip: "Switch to Floating Mini Player (Ref 2)";
                            clicked => { root.switch_to_mini(); }
                        }

                        AuriIconButton {
                            icon_source: @image-url("../assets/icons/gamepad.svg");
                            icon_size: 16px;
                            btn_size: 32px;
                            tooltip: "Switch to Gaming Mode (0% GPU)";
                            clicked => { root.switch_to_gaming(); }
                        }
                    }
                }

                // ==========================================
                // MAIN SCROLLABLE CONTENT REGION
                // ==========================================
                ScrollView {
                    vertical_stretch: 1;

                    VerticalLayout {
                        padding_bottom: 24px;
                        spacing: 24px;

                        // ------------------------------------------
                        // VIEW 1: HOME VIEW
                        // ------------------------------------------
                        if root.current_nav == "home": VerticalLayout {
                            spacing: 24px;

                            // Quick Picks (2-Column Grid matching Tubefast Image 2)
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    Text {
                                        text: "Quick picks";
                                        font_size: 20px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                        horizontal_stretch: 1;
                                    }
                                    Text {
                                        text: "Show all";
                                        font_size: 12px;
                                        font_weight: 600;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;

                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        spacing: 2px;
                                        for track in root.quick_picks_col1: AuriTrackCard {
                                            track_id: track.id;
                                            title: track.title;
                                            subtitle: track.artist + (track.album != "" ? " • " + track.album : "");
                                            color_hue: track.color_hue;
                                            is_playing: root.track_title == track.title && root.is_playing;
                                            clicked => {
                                                root.play_track(track.id, track.title, track.artist, 214);
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        spacing: 2px;
                                        for track in root.quick_picks_col2: AuriTrackCard {
                                            track_id: track.id;
                                            title: track.title;
                                            subtitle: track.artist + (track.album != "" ? " • " + track.album : "");
                                            color_hue: track.color_hue;
                                            is_playing: root.track_title == track.title && root.is_playing;
                                            clicked => {
                                                root.play_track(track.id, track.title, track.artist, 214);
                                            }
                                        }
                                    }
                                }
                            }

                            // More Like Section (2-Column Grid matching Tubefast Image 2)
                            if root.more_like_col1.length > 0: VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    Text {
                                        text: root.more_like_title;
                                        font_size: 20px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                        horizontal_stretch: 1;
                                    }
                                    Text {
                                        text: "Show all";
                                        font_size: 12px;
                                        font_weight: 600;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 16px;

                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        spacing: 2px;
                                        for track in root.more_like_col1: AuriTrackCard {
                                            track_id: track.id;
                                            title: track.title;
                                            subtitle: track.artist + (track.album != "" ? " • " + track.album : "");
                                            color_hue: track.color_hue;
                                            is_playing: root.track_title == track.title && root.is_playing;
                                            clicked => {
                                                root.play_track(track.id, track.title, track.artist, 214);
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        spacing: 2px;
                                        for track in root.more_like_col2: AuriTrackCard {
                                            track_id: track.id;
                                            title: track.title;
                                            subtitle: track.artist + (track.album != "" ? " • " + track.album : "");
                                            color_hue: track.color_hue;
                                            is_playing: root.track_title == track.title && root.is_playing;
                                            clicked => {
                                                root.play_track(track.id, track.title, track.artist, 214);
                                            }
                                        }
                                    }
                                }
                            }

                            // Albums Section (Square Cards, Left-Aligned Titles)
                            VerticalLayout {
                                spacing: 12px;

                                HorizontalLayout {
                                    Text {
                                        text: "Albums";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                        horizontal_stretch: 1;
                                    }
                                    Text {
                                        text: "Sort by Year ▼";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                        vertical_alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    for album in root.home_albums: Rectangle {
                                        horizontal_stretch: 1;
                                        border-radius: Theme.radius_md;
                                        background: album_item_touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
                                        border-width: 1px;
                                        border-color: Theme.border_glass;

                                        album_item_touch := TouchArea {
                                            clicked => { root.play_album(album.id); }
                                        }

                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 8px;

                                            // Album Art Sleeve Container
                                            Rectangle {
                                                height: 104px;
                                                border-radius: Theme.radius_sm;
                                                clip: true;
                                                background: @linear-gradient(135deg, album.color_hue.darker(30%) 0%, #0F111A 100%);
                                                border-width: 1px;
                                                border-color: Theme.border_glass;

                                                // Stylized LP Sleeve Artwork (Left-Aligned)
                                                Rectangle {
                                                    width: 44px;
                                                    height: 44px;
                                                    border-radius: 22px;
                                                    background: @linear-gradient(135deg, #1A1D2B 0%, #0A0B10 100%);
                                                    border-width: 1.5px;
                                                    border-color: album.color_hue;
                                                    x: 14px;
                                                    y: (parent.height - self.height) / 2;

                                                    Image {
                                                        source: @image-url("../assets/icons/album.svg");
                                                        width: 20px;
                                                        height: 20px;
                                                        image-fit: contain;
                                                        colorize: #FFFFFF;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }

                                                // Play overlay on card hover
                                                if album_item_touch.has_hover : Rectangle {
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 16px;
                                                    background: Theme.accent;
                                                    x: parent.width - self.width - 12px;
                                                    y: (parent.height - self.height) / 2;

                                                    Image {
                                                        source: @image-url("../assets/icons/play.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        image-fit: contain;
                                                        colorize: #FFFFFF;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }

                                            // Metadata (Strict Left-Aligned)
                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: start;

                                                Text {
                                                    text: album.title;
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                    overflow: elide;
                                                    horizontal_alignment: left;
                                                }
                                                Text {
                                                    text: album.artist != "" ? album.artist + " • " + album.year : album.year;
                                                    font_size: 11px;
                                                    color: Theme.text_muted;
                                                    overflow: elide;
                                                    horizontal_alignment: left;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Popular Tracks & Similar Artists Columns (Reference 1 Left-Aligned Layout)
                            HorizontalLayout {
                                spacing: 24px;

                                // Popular Tracks Precision Table
                                VerticalLayout {
                                    horizontal_stretch: 3;
                                    spacing: 8px;

                                    Text {
                                        text: "Popular";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    VerticalLayout {
                                        spacing: 1px;

                                        for track[idx] in root.home_tracks: Rectangle {
                                            height: 48px;
                                            border-radius: Theme.radius_sm;
                                            background: pop_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                            pop_touch := TouchArea {
                                                clicked => {
                                                    root.play_track(track.id, track.title, track.artist, 214);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding_left: 8px;
                                                padding_right: 8px;
                                                spacing: 12px;

                                                // Column 1: Index
                                                Text {
                                                    text: idx + 1;
                                                    font_size: 13px;
                                                    font_weight: 600;
                                                    color: Theme.text_muted;
                                                    width: 18px;
                                                    vertical_alignment: center;
                                                }

                                                // Column 2: Track Artwork Thumbnail (Left-Aligned Studio Presentation)
                                                Rectangle {
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 6px;
                                                    clip: true;
                                                    background: @linear-gradient(135deg, track.color_hue.darker(30%) 0%, #151722 100%);
                                                    border-width: 1px;
                                                    border-color: Theme.border_glass;
                                                    y: (parent.height - self.height) / 2;

                                                    Image {
                                                        source: @image-url("../assets/icons/music.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        image-fit: contain;
                                                        colorize: #FFFFFF;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }

                                                // Column 3: Stacked Title & Subtitle (Left-Aligned)
                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;

                                                    Text {
                                                        text: track.title;
                                                        font_size: 13px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: track.artist + (track.album != "" ? " • " + track.album : "");
                                                        font_size: 11px;
                                                        color: Theme.text_muted;
                                                        overflow: elide;
                                                    }
                                                }

                                                // Column 3: Format Badge
                                                Rectangle {
                                                    width: 52px;
                                                    height: 18px;
                                                    border-radius: 4px;
                                                    background: Theme.badge_bg;
                                                    border-width: 1px;
                                                    border-color: Theme.badge_border;

                                                    Text {
                                                        text: track.format_badge;
                                                        font_size: 9px;
                                                        font_weight: 700;
                                                        color: Theme.badge_text;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }

                                                // Column 4: Duration
                                                Text {
                                                    text: track.duration;
                                                    font_size: 11px;
                                                    color: Theme.text_muted;
                                                    vertical_alignment: center;
                                                }

                                                // Column 5: Favorite Action
                                                AuriIconButton {
                                                    icon_source: track.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                                                    icon_size: 13px;
                                                    btn_size: 26px;
                                                    active_color: Theme.favorite_active;
                                                    is_active: track.is_favorite;
                                                    tooltip: "Favorite";
                                                    clicked => { root.toggle_track_favorite(track.id); }
                                                }

                                                // Column 6: Play Action
                                                AuriIconButton {
                                                    icon_source: @image-url("../assets/icons/play.svg");
                                                    icon_size: 13px;
                                                    btn_size: 26px;
                                                    tooltip: "Play " + track.title;
                                                    clicked => {
                                                        root.play_track(track.id, track.title, track.artist, 214);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Similar Artists Precision Column (Reference 1 Style)
                                VerticalLayout {
                                    horizontal_stretch: 2;
                                    spacing: 8px;

                                    Text {
                                        text: "Similar Artist";
                                        font_size: 18px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;

                                        for artist in root.similar_artists: Rectangle {
                                            height: 44px;
                                            border-radius: Theme.radius_sm;
                                            background: sim_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                            sim_touch := TouchArea {
                                                clicked => {
                                                    root.perform_search(artist.name);
                                                    root.navigate("search");
                                                }
                                            }

                                            HorizontalLayout {
                                                padding_left: 8px;
                                                padding_right: 8px;
                                                spacing: 12px;

                                                Rectangle {
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 16px;
                                                    background: @linear-gradient(135deg, artist.color_hue 0%, artist.color_hue.darker(35%) 100%);
                                                    border-width: 1px;
                                                    border-color: Theme.border_glass_highlight;
                                                    y: (parent.height - self.height) / 2;

                                                    Image {
                                                        source: @image-url("../assets/icons/user.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        image-fit: contain;
                                                        colorize: #FFFFFF;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: artist.name;
                                                        font_size: 13px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: artist.role;
                                                        font_size: 11px;
                                                        color: Theme.text_muted;
                                                        overflow: elide;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 64px;
                                                    height: 24px;
                                                    border-radius: Theme.radius_pill;
                                                    background: fol_touch.has_hover ? Theme.accent : Theme.bg_surface_elevated;
                                                    border-width: 1px;
                                                    border-color: Theme.border_glass;

                                                    fol_touch := TouchArea {}

                                                    Text {
                                                        text: "+ Follow";
                                                        font_size: 10px;
                                                        font_weight: 600;
                                                        color: #FFFFFF;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 2: SEARCH VIEW (Precision Table Structure)
                        // ------------------------------------------
                        if root.current_nav == "search": VerticalLayout {
                            spacing: 14px;

                            Text {
                                text: root.search_query != "" ? "Search Results for \"" + root.search_query + "\"" : "Search YouTube Music Catalog";
                                font_size: 20px;
                                font_weight: 800;
                                color: #FFFFFF;
                            }

                            if root.search_results.length == 0: Rectangle {
                                height: 180px;
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 10px;

                                    Image {
                                        source: @image-url("../assets/icons/search.svg");
                                        width: 32px;
                                        height: 32px;
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                    }
                                    Text {
                                        text: root.search_query == "" ? "Type any song, artist or album name above and press Enter." : "No tracks found for \"" + root.search_query + "\".";
                                        font_size: 13px;
                                        color: Theme.text_secondary;
                                        horizontal_alignment: center;
                                    }
                                }
                            }

                            // Table of Results (Apple Music Table, Strict Left Alignment)
                            if root.search_results.length > 0: VerticalLayout {
                                spacing: 2px;

                                // Table Column Headers
                                HorizontalLayout {
                                    padding_left: 12px;
                                    padding_right: 12px;
                                    spacing: 14px;
                                    height: 22px;

                                    Text {
                                        text: "#";
                                        font_size: 11px;
                                        font_weight: 700;
                                        color: Theme.text_muted;
                                        width: 18px;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: "TITLE / ARTIST";
                                        font_size: 10px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                        horizontal_stretch: 1;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: "FORMAT";
                                        font_size: 10px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                        width: 58px;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                    Text {
                                        text: "TIME";
                                        font_size: 10px;
                                        font_weight: 700;
                                        letter_spacing: 0.8px;
                                        color: Theme.text_muted;
                                        width: 44px;
                                        horizontal_alignment: right;
                                        vertical_alignment: center;
                                    }
                                    Rectangle { width: 28px; } // Spacer for play action column
                                }

                                for res[idx] in root.search_results: Rectangle {
                                    height: 46px;
                                    border-radius: Theme.radius_sm;
                                    background: search_row_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    search_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(res.id, res.title, res.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 14px;

                                        // Col 1: Index Number
                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 18px;
                                            vertical_alignment: center;
                                        }

                                        // Col 2: Artwork
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        // Col 3: Title & Subtitle (Left-Aligned)
                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: res.title;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: res.artist;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        // Col 4: Format Badge
                                        Rectangle {
                                            width: 58px;
                                            height: 18px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            border-width: 1px;
                                            border-color: Theme.badge_border;

                                            Text {
                                                text: res.format_badge;
                                                font_size: 9px;
                                                font_weight: 700;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        // Col 5: Duration
                                        Text {
                                            text: res.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            width: 44px;
                                            horizontal_alignment: right;
                                            vertical_alignment: center;
                                        }

                                        // Col 6: Instant Play Button
                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play " + res.title;
                                            clicked => {
                                                root.play_track(res.id, res.title, res.artist, 200);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 2.5: RECENTLY PLAYED VIEW (Tubefast Image 3)
                        // ------------------------------------------
                        if root.current_nav == "recent": VerticalLayout {
                            spacing: 18px;

                            // Large Banner Header matching Tubefast Image 3
                            Rectangle {
                                height: 140px;
                                border-radius: Theme.radius_md;
                                background: @linear-gradient(135deg, #1C1B20 0%, #121318 100%);
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 20px;
                                    alignment: center;

                                    // Warm Charcoal Card with Orange History Clock Icon
                                    Rectangle {
                                        width: 108px;
                                        height: 108px;
                                        border-radius: 12px;
                                        background: @linear-gradient(135deg, #2D2722 0%, #1A1715 100%);
                                        border-width: 1px;
                                        border-color: #FF550033;

                                        Image {
                                            source: @image-url("../assets/icons/history.svg");
                                            width: 48px;
                                            height: 48px;
                                            image-fit: contain;
                                            colorize: #FF5500;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    // Title + Song Count + Action Controls
                                    VerticalLayout {
                                        horizontal_stretch: 1;
                                        alignment: center;
                                        spacing: 6px;

                                        Text {
                                            text: "Recently played";
                                            font_size: 30px;
                                            font_weight: 800;
                                            color: #FFFFFF;
                                        }

                                        Text {
                                            text: root.recent_tracks.length + " songs";
                                            font_size: 13px;
                                            color: Theme.text_muted;
                                        }

                                        HorizontalLayout {
                                            spacing: 16px;
                                            alignment: start;

                                            // Orange "Play" Pill Button
                                            Rectangle {
                                                width: 88px;
                                                height: 32px;
                                                border-radius: Theme.radius_pill;
                                                background: @linear-gradient(135deg, #FF5500 0%, #FF7700 100%);

                                                TouchArea {
                                                    clicked => { root.play_all_recent(); }
                                                }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: center;

                                                    Image {
                                                        source: @image-url("../assets/icons/play.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        image-fit: contain;
                                                        colorize: #FFFFFF;
                                                    }

                                                    Text {
                                                        text: "Play";
                                                        font_size: 12px;
                                                        font_weight: 700;
                                                        color: #FFFFFF;
                                                    }
                                                }
                                            }

                                            // Clear history text button
                                            Rectangle {
                                                height: 32px;

                                                TouchArea {
                                                    clicked => { root.clear_history(); }
                                                }

                                                Text {
                                                    text: "Clear history";
                                                    font_size: 12px;
                                                    font_weight: 600;
                                                    color: Theme.text_muted;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Empty State
                            if root.recent_tracks.length == 0: Rectangle {
                                height: 160px;
                                border-radius: Theme.radius_md;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Image {
                                        source: @image-url("../assets/icons/history.svg");
                                        width: 32px;
                                        height: 32px;
                                        image-fit: contain;
                                        colorize: Theme.text_muted;
                                        x: (parent.width - self.width) / 2;
                                    }

                                    Text {
                                        text: "No recently played songs yet";
                                        font_size: 13px;
                                        color: Theme.text_secondary;
                                        horizontal_alignment: center;
                                    }
                                }
                            }

                            // Table of Recent Tracks (matching Tubefast Image 3)
                            if root.recent_tracks.length > 0: VerticalLayout {
                                spacing: 2px;

                                for rtrack[idx] in root.recent_tracks: Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_sm;
                                    background: r_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    r_touch := TouchArea {
                                        clicked => {
                                            root.play_track(rtrack.id, rtrack.title, rtrack.artist, 210);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 10px;
                                        padding_right: 12px;
                                        spacing: 12px;

                                        // Artwork (40x40px)
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 6px;
                                            clip: true;
                                            background: @linear-gradient(135deg, rtrack.color_hue.darker(30%) 0%, #151722 100%);
                                            border-width: 1px;
                                            border-color: Theme.border_glass;
                                            y: (parent.height - self.height) / 2;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 15px;
                                                height: 15px;
                                                image-fit: contain;
                                                colorize: #FFFFFF;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        // Title & Artist
                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: rtrack.title;
                                                font_size: 13px;
                                                font_weight: 600;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: rtrack.artist;
                                                font_size: 11px;
                                                color: Theme.text_muted;
                                                overflow: elide;
                                            }
                                        }

                                        // Heart Icon
                                        AuriIconButton {
                                            icon_source: rtrack.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                                            icon_size: 13px;
                                            btn_size: 26px;
                                            active_color: Theme.favorite_active;
                                            is_active: rtrack.is_favorite;
                                            tooltip: "Favorite";
                                            clicked => { root.toggle_track_favorite(rtrack.id); }
                                        }

                                        // Duration
                                        Text {
                                            text: rtrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                            width: 36px;
                                            horizontal_alignment: right;
                                        }

                                        // More options icon
                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/more.svg");
                                            icon_size: 14px;
                                            btn_size: 26px;
                                            tooltip: "More Options";
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 3: ALBUMS VIEW
                        // ------------------------------------------
                        if root.current_nav == "albums": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                Text {
                                    text: "Albums Collection";
                                    font_size: 20px;
                                    font_weight: 800;
                                    color: #FFFFFF;
                                    horizontal_stretch: 1;
                                }
                                Text {
                                    text: root.all_albums.length + " Albums in Library";
                                    font_size: 12px;
                                    color: Theme.text_muted;
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                for alb in root.all_albums: Rectangle {
                                    horizontal_stretch: 1;
                                    height: 170px;
                                    border-radius: Theme.radius_md;
                                    background: alb_card_touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
                                    border-width: 1px;
                                    border-color: Theme.border_glass;

                                    alb_card_touch := TouchArea {
                                        clicked => { root.play_album(alb.id); }
                                    }

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        Rectangle {
                                            height: 96px;
                                            border-radius: Theme.radius_sm;
                                            background: alb.color_hue;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/album.svg");
                                                width: 32px;
                                                height: 32px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: start;
                                            Text {
                                                text: alb.title;
                                                font_size: 12px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: alb.artist + " (" + alb.year + ")";
                                                font_size: 10px;
                                                color: Theme.text_muted;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 4: LOCAL FILES VIEW
                        // ------------------------------------------
                        if root.current_nav == "local": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Local Music Library";
                                        font_size: 20px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }
                                    Text {
                                        text: "Path: " + root.local_music_path;
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                Rectangle {
                                    width: 120px;
                                    height: 30px;
                                    border-radius: Theme.radius_pill;
                                    background: Theme.bg_surface_elevated;
                                    border-width: 1px;
                                    border-color: Theme.border_glass;

                                    TouchArea {
                                        clicked => { root.rescan_local(root.local_music_path); }
                                    }

                                    Text {
                                        text: "🔄 Rescan Folder";
                                        font_size: 11px;
                                        font_weight: 700;
                                        color: #FFFFFF;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;

                                for ltrack[idx] in root.local_tracks: Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_sm;
                                    background: local_row_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    local_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(ltrack.id, ltrack.title, ltrack.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 14px;

                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 18px;
                                            vertical_alignment: center;
                                        }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: ltrack.title;
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ltrack.artist + " • " + ltrack.album;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 54px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: Theme.badge_bg;
                                            border-width: 1px;
                                            border-color: Theme.badge_border;
                                            y: (parent.height - self.height) / 2;

                                            Text {
                                                text: ltrack.format_badge;
                                                font_size: 9px;
                                                font_weight: 800;
                                                color: Theme.badge_text;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }

                                        Text {
                                            text: ltrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/play.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            tooltip: "Play " + ltrack.title;
                                            clicked => {
                                                root.play_track(ltrack.id, ltrack.title, ltrack.artist, 200);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 5: FAVORITES VIEW
                        // ------------------------------------------
                        if root.current_nav == "favorites": VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Favorite Tracks";
                                        font_size: 20px;
                                        font_weight: 800;
                                        color: #FFFFFF;
                                    }
                                    Text {
                                        text: root.favorite_tracks.length + " Starred Songs";
                                        font_size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                Rectangle {
                                    width: 100px;
                                    height: 30px;
                                    border-radius: Theme.radius_pill;
                                    background: Theme.accent;

                                    TouchArea {
                                        clicked => {
                                            if root.favorite_tracks.length > 0 {
                                                root.play_track(root.favorite_tracks[0].id, root.favorite_tracks[0].title, root.favorite_tracks[0].artist, 200);
                                            }
                                        }
                                    }

                                    Text {
                                        text: "▶ Play All";
                                        font_size: 12px;
                                        font_weight: 700;
                                        color: #FFFFFF;
                                        horizontal_alignment: center;
                                        vertical_alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;

                                for ftrack[idx] in root.favorite_tracks: Rectangle {
                                    height: 48px;
                                    border-radius: Theme.radius_sm;
                                    background: fav_row_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                                    fav_row_touch := TouchArea {
                                        clicked => {
                                            root.play_track(ftrack.id, ftrack.title, ftrack.artist, 200);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding_left: 12px;
                                        padding_right: 12px;
                                        spacing: 14px;

                                        Text {
                                            text: idx + 1;
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: Theme.text_muted;
                                            width: 18px;
                                            vertical_alignment: center;
                                        }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 6px;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            Image {
                                                source: @image-url("../assets/icons/music.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: ftrack.title;
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ftrack.artist;
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                                overflow: elide;
                                            }
                                        }

                                        Text {
                                            text: ftrack.duration;
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                            vertical_alignment: center;
                                        }

                                        AuriIconButton {
                                            icon_source: @image-url("../assets/icons/heart-filled.svg");
                                            icon_size: 14px;
                                            btn_size: 28px;
                                            active_color: Theme.favorite_active;
                                            is_active: true;
                                            tooltip: "Remove from Favorites";
                                            clicked => { root.toggle_track_favorite(ftrack.id); }
                                        }
                                    }
                                }
                            }
                        }

                        // ------------------------------------------
                        // VIEW 6: SETTINGS VIEW (Overhauled macOS / Apple Style)
                        // ------------------------------------------
                        if root.current_nav == "settings": VerticalLayout {
                            spacing: 18px;

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Settings & System Performance";
                                    font_size: 22px;
                                    font_weight: 800;
                                    color: #FFFFFF;
                                }
                                Text {
                                    text: "Configure audio decoding, latency buffers, and background gaming optimizations.";
                                    font_size: 12px;
                                    color: Theme.text_secondary;
                                }
                            }

                            // Section 1: Audio Engine Architecture (Dual-Engine)
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "AUDIO ENGINE ARCHITECTURE";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    // Option 1: Native WASAPI
                                    Rectangle {
                                        height: 68px;
                                        border-radius: Theme.radius_md;
                                        background: root.audio_engine_name == "Native WASAPI" ? #6366F126 : (eng1_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated);
                                        border-width: 1px;
                                        border-color: root.audio_engine_name == "Native WASAPI" ? Theme.accent : Theme.border_glass;

                                        eng1_touch := TouchArea {
                                            clicked => { root.switch_audio_engine(0); }
                                        }

                                        HorizontalLayout {
                                            padding_left: 16px;
                                            padding_right: 16px;
                                            spacing: 14px;
                                            alignment: center;

                                            Image {
                                                source: @image-url("../assets/icons/gamepad.svg");
                                                width: 22px;
                                                height: 22px;
                                                image-fit: contain;
                                            }

                                            VerticalLayout {
                                                horizontal_stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Native WASAPI Shared Mode (Gaming Recommended)";
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                }
                                                Text {
                                                    text: "Pure Rust Symphonia AAC/Opus/FLAC decoder + Catmull-Rom resampler. MMCSS real-time thread, 0% GPU, < 35 MB RAM.";
                                                    font_size: 11px;
                                                    color: Theme.text_secondary;
                                                }
                                            }

                                            if root.audio_engine_name == "Native WASAPI": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: Theme.accent;

                                                Text {
                                                    text: "✓";
                                                    font_size: 11px;
                                                    font_weight: 800;
                                                    color: #FFFFFF;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Option 2: Studio libmpv
                                    Rectangle {
                                        height: 68px;
                                        border-radius: Theme.radius_md;
                                        background: root.audio_engine_name != "Native WASAPI" ? #6366F126 : (eng2_touch.has_hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated);
                                        border-width: 1px;
                                        border-color: root.audio_engine_name != "Native WASAPI" ? Theme.accent : Theme.border_glass;

                                        eng2_touch := TouchArea {
                                            clicked => { root.switch_audio_engine(1); }
                                        }

                                        HorizontalLayout {
                                            padding_left: 16px;
                                            padding_right: 16px;
                                            spacing: 14px;
                                            alignment: center;

                                            Image {
                                                source: @image-url("../assets/icons/settings.svg");
                                                width: 22px;
                                                height: 22px;
                                                image-fit: contain;
                                            }

                                            VerticalLayout {
                                                horizontal_stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Studio libmpv Engine (Audiophile)";
                                                    font_size: 13px;
                                                    font_weight: 700;
                                                    color: #FFFFFF;
                                                }
                                                Text {
                                                    text: "C libmpv backend with gapless lookahead deck, crossfade, and Soxr polyphase Sinc resampling.";
                                                    font_size: 11px;
                                                    color: Theme.text_secondary;
                                                }
                                            }

                                            if root.audio_engine_name != "Native WASAPI": Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: Theme.accent;

                                                Text {
                                                    text: "✓";
                                                    font_size: 11px;
                                                    font_weight: 800;
                                                    color: #FFFFFF;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Section 2: Audio Dynamics & Fidelity Processing
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "DYNAMICS & FIDELITY PROCESSING";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: center;

                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: "YouTube Music -7.0 LUFS Target Normalization & Peak Limiter";
                                                font_size: 13px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                            }
                                            Text {
                                                text: "Applies continuous gain scaling matching YouTube Music standards with zero digital clipping.";
                                                font_size: 11px;
                                                color: Theme.text_secondary;
                                            }
                                        }

                                        Rectangle {
                                            width: 48px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: root.loudness_norm_enabled ? Theme.accent : Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            TouchArea {
                                                clicked => { root.toggle_loudness(!root.loudness_norm_enabled); }
                                            }

                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: #FFFFFF;
                                                x: root.loudness_norm_enabled ? parent.width - self.width - 3px : 3px;
                                                y: 3px;
                                                animate x { duration: 120ms; }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "MMCSS Scheduling:";
                                            font_size: 11px;
                                            color: Theme.text_muted;
                                        }
                                        Text {
                                            text: "AvSetMmThreadCharacteristicsW(\"Audio\") Priority Active";
                                            font_size: 11px;
                                            font_weight: 700;
                                            color: Theme.success;
                                        }
                                    }
                                }
                            }

                            // Section 3: Local Library Directory Path
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "LOCAL MUSIC DIRECTORY";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 38px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.bg_surface_elevated;
                                            border-width: 1px;
                                            border-color: Theme.border_glass;

                                            HorizontalLayout {
                                                padding_left: 14px;
                                                padding_right: 14px;
                                                TextInput {
                                                    text <=> root.local_music_path;
                                                    font_size: 12px;
                                                    color: #FFFFFF;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 110px;
                                            height: 38px;
                                            border-radius: Theme.radius_md;
                                            background: Theme.accent;

                                            TouchArea {
                                                clicked => { root.rescan_local(root.local_music_path); }
                                            }

                                            Text {
                                                text: "Scan Path";
                                                font_size: 12px;
                                                font_weight: 700;
                                                color: #FFFFFF;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Section 4: Player Bar Layout Interface Preference
                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: Theme.bg_surface_glass;
                                border-width: 1px;
                                border-color: Theme.border_glass;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "PLAYER INTERFACE & LAYOUT";
                                        font_size: 10px;
                                        font_weight: 800;
                                        letter_spacing: 1px;
                                        color: Theme.text_muted;
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;

                                        // Option 1: Bottom Player Bar
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 54px;
                                            border-radius: Theme.radius_md;
                                            background: root.player_layout == "bottom" ? Theme.bg_surface_elevated : Theme.bg_card;
                                            border-width: 1.5px;
                                            border-color: root.player_layout == "bottom" ? Theme.accent : Theme.border_glass;

                                            TouchArea {
                                                clicked => {
                                                    if root.player_layout != "bottom" {
                                                        root.toggle_player_layout();
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 10px;
                                                alignment: center;

                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    spacing: 2px;
                                                    Text {
                                                        text: "Bottom Player Bar (Tubefast Style)";
                                                        font_size: 13px;
                                                        font_weight: 700;
                                                        color: #FFFFFF;
                                                    }
                                                    Text {
                                                        text: "Pinned 80px bottom playback controller with full-width scrubber.";
                                                        font_size: 11px;
                                                        color: Theme.text_secondary;
                                                    }
                                                }

                                                if root.player_layout == "bottom": Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: Theme.accent;
                                                    Text {
                                                        text: "✓";
                                                        font_size: 10px;
                                                        font_weight: 800;
                                                        color: #FFFFFF;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Option 2: Right Sidebar Showcase
                                        Rectangle {
                                            horizontal_stretch: 1;
                                            height: 54px;
                                            border-radius: Theme.radius_md;
                                            background: root.player_layout == "sidebar" ? Theme.bg_surface_elevated : Theme.bg_card;
                                            border-width: 1.5px;
                                            border-color: root.player_layout == "sidebar" ? Theme.accent : Theme.border_glass;

                                            TouchArea {
                                                clicked => {
                                                    if root.player_layout != "sidebar" {
                                                        root.toggle_player_layout();
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 10px;
                                                alignment: center;

                                                VerticalLayout {
                                                    horizontal_stretch: 1;
                                                    spacing: 2px;
                                                    Text {
                                                        text: "Right Sidebar Studio Showcase";
                                                        font_size: 13px;
                                                        font_weight: 700;
                                                        color: #FFFFFF;
                                                    }
                                                    Text {
                                                        text: "Prominent 214px large cover showcase in persistent right panel.";
                                                        font_size: 11px;
                                                        color: Theme.text_secondary;
                                                    }
                                                }

                                                if root.player_layout == "sidebar": Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: Theme.accent;
                                                    Text {
                                                        text: "✓";
                                                        font_size: 10px;
                                                        font_weight: 800;
                                                        color: #FFFFFF;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // 3. RIGHT PANEL: PLAY QUEUE & NOW PLAYING (Shown in Sidebar mode or when Queue is toggled in Bottom mode)
        // ==========================================
        if root.player_layout == "sidebar" || (root.player_layout == "bottom" && root.show_queue): Rectangle {
            width: 270px;
            background: Theme.bg_sidebar;
            border-width: 1px;
            border-color: Theme.border_glass;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;

                // If sidebar layout: Show the large 214px Studio Showcase card!
                if root.player_layout == "sidebar": VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        Text {
                            text: "Play queue";
                            font_size: 16px;
                            font_weight: 800;
                            color: #FFFFFF;
                            horizontal_stretch: 1;
                        }
                        Text {
                            text: root.queue_tracks.length + " Tracks";
                            font_size: 11px;
                            color: Theme.text_muted;
                            vertical_alignment: center;
                        }
                    }

                    // Studio-Grade Now Playing Showcase Card (Large Artwork Showcase)
                    Rectangle {
                        height: 380px;
                        border-radius: Theme.radius_lg;
                        background: Theme.bg_card;
                        border-width: 1px;
                        border-color: Theme.border_glass;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            alignment: center;

                            // Large Cover Artwork Showcase (214x214px Studio Square)
                            Rectangle {
                                width: 214px;
                                height: 214px;
                                border-radius: 14px;
                                clip: true;
                                background: #141624;
                                border-width: 1.5px;
                                border-color: root.is_playing ? Theme.accent : Theme.border_glass;

                                if root.has_artwork : Image {
                                    source: root.artwork;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }

                                if !root.has_artwork : Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    background: @linear-gradient(135deg, #1A1D2E 0%, #0E101A 100%);

                                    Image {
                                        source: @image-url("../assets/brand_64.png");
                                        width: 64px;
                                        height: 64px;
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // Track Title & Artist
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: root.track_title;
                                    font_size: 14px;
                                    font_weight: 700;
                                    color: #FFFFFF;
                                    horizontal_alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.track_artist;
                                    font_size: 11px;
                                    font_weight: 500;
                                    color: Theme.text_secondary;
                                    horizontal_alignment: center;
                                    overflow: elide;
                                }
                            }

                            // Seekbar & Time
                            VerticalLayout {
                                spacing: 2px;

                                AuriSlider {
                                    height: 22px;
                                    value: root.track_progress;
                                    value_changed(val) => { root.seek(val); }
                                }

                                HorizontalLayout {
                                    Text {
                                        text: root.track_elapsed;
                                        font_size: 10px;
                                        font_weight: 600;
                                        color: Theme.text_muted;
                                        horizontal_stretch: 1;
                                    }
                                    Text {
                                        text: root.track_duration;
                                        font_size: 10px;
                                        font_weight: 600;
                                        color: Theme.text_muted;
                                    }
                                }
                            }

                            // Transport Controls
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/shuffle.svg");
                                    icon_size: 13px;
                                    btn_size: 28px;
                                    is_active: root.is_shuffle;
                                    tooltip: "Shuffle";
                                    clicked => { root.toggle_shuffle(); }
                                }

                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/prev.svg");
                                    icon_size: 15px;
                                    btn_size: 28px;
                                    tooltip: "Previous";
                                    clicked => { root.prev_track(); }
                                }

                                AuriPlayButton {
                                    button_size: 38px;
                                    is_playing: root.is_playing;
                                    clicked => { root.toggle_play(); }
                                }

                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/next.svg");
                                    icon_size: 15px;
                                    btn_size: 28px;
                                    tooltip: "Next";
                                    clicked => { root.next_track(); }
                                }

                                AuriIconButton {
                                    icon_source: @image-url("../assets/icons/repeat.svg");
                                    icon_size: 13px;
                                    btn_size: 28px;
                                    is_active: root.is_repeat;
                                    tooltip: "Repeat";
                                    clicked => { root.toggle_repeat(); }
                                }
                            }
                        }
                    }
                }

                // If bottom player layout: Show Tubefast Style Right Queue (Image 2)
                if root.player_layout == "bottom": VerticalLayout {
                    spacing: 10px;

                    Text {
                        text: "NOW PLAYING";
                        font_size: 11px;
                        font_weight: 800;
                        letter_spacing: 0.8px;
                        color: Theme.text_muted;
                    }

                    // Compact Now Playing Card (matching Tubefast Image 2)
                    Rectangle {
                        height: 64px;
                        border-radius: Theme.radius_sm;
                        background: Theme.bg_surface_elevated;
                        border-width: 1px;
                        border-color: Theme.border_glass;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            alignment: center;

                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 6px;
                                clip: true;
                                background: #141624;
                                border-width: 1px;
                                border-color: root.is_playing ? Theme.accent : Theme.border_glass;

                                if root.has_artwork : Image {
                                    source: root.artwork;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }

                                if !root.has_artwork : Image {
                                    source: @image-url("../assets/brand_64.png");
                                    width: 24px;
                                    height: 24px;
                                    image-fit: contain;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                horizontal_stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.track_title;
                                    font_size: 12px;
                                    font_weight: 700;
                                    color: #FFFFFF;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.track_artist;
                                    font_size: 10px;
                                    color: Theme.text_secondary;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Up Next Queue Header
                Text {
                    text: root.player_layout == "bottom" ? "NEXT UP" : "Up Next";
                    font_size: 11px;
                    font_weight: 800;
                    letter_spacing: 0.8px;
                    color: Theme.text_muted;
                }

                // Up Next Items List (Scrollable)
                ScrollView {
                    vertical_stretch: 1;

                    VerticalLayout {
                        padding_right: 10px;
                        spacing: 2px;

                        for qtrack in root.queue_tracks: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius_sm;
                            background: q_touch.has_hover ? Theme.bg_surface_hover : Colors.transparent;

                            q_touch := TouchArea {
                                clicked => {
                                    root.play_track(qtrack.id, qtrack.title, qtrack.artist, 200);
                                }
                            }

                            HorizontalLayout {
                                padding_left: 6px;
                                padding_right: 6px;
                                spacing: 10px;

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 4px;
                                    clip: true;
                                    background: Theme.bg_surface_elevated;
                                    border-width: 1px;
                                    border-color: Theme.border_glass;
                                    y: (parent.height - self.height) / 2;

                                    Image {
                                        source: @image-url("../assets/icons/music.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                VerticalLayout {
                                    horizontal_stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: qtrack.title;
                                        font_size: 12px;
                                        font_weight: 600;
                                        color: #FFFFFF;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: qtrack.artist;
                                        font_size: 10px;
                                        color: Theme.text_muted;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: qtrack.duration;
                                    font_size: 10px;
                                    color: Theme.text_muted;
                                    vertical_alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    } // closes HorizontalLayout

    // ==========================================
    // 4. BOTTOM PLAYER BAR: TUBEFAST STYLE CONTROLLER (Image 2)
    // ==========================================
    if root.player_layout == "bottom": Rectangle {
        height: 80px;
        background: #111218FA;

        // Top 1px border divider
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.border_glass;
        }

        // Scrubber line across top edge of bar (0 to 100%)
        HorizontalLayout {
            y: 0;
            height: 14px;

            AuriSlider {
                height: 14px;
                value: root.track_progress;
                value_changed(val) => { root.seek(val); }
            }
        }

        // Playback & Controls Row
        HorizontalLayout {
            y: 14px;
            height: 66px;
            padding_left: 16px;
            padding_right: 16px;
            spacing: 16px;
            alignment: center;

            // Left: Artwork + Title + Artist + Heart + Share
            HorizontalLayout {
                width: 280px;
                spacing: 12px;
                alignment: start;
                y: (parent.height - self.height) / 2;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 6px;
                    clip: true;
                    background: #141624;
                    border-width: 1px;
                    border-color: root.is_playing ? Theme.accent : Theme.border_glass;
                    y: (parent.height - self.height) / 2;

                    if root.has_artwork : Image {
                        source: root.artwork;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }

                    if !root.has_artwork : Image {
                        source: @image-url("../assets/brand_64.png");
                        width: 28px;
                        height: 28px;
                        image-fit: contain;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    horizontal_stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.track_title;
                        font_size: 13px;
                        font_weight: 700;
                        color: #FFFFFF;
                        overflow: elide;
                    }
                    Text {
                        text: root.track_artist;
                        font_size: 11px;
                        color: Theme.text_secondary;
                        overflow: elide;
                    }
                }

                AuriIconButton {
                    icon_source: root.is_favorite ? @image-url("../assets/icons/heart-filled.svg") : @image-url("../assets/icons/heart.svg");
                    icon_size: 14px;
                    btn_size: 30px;
                    active_color: Theme.favorite_active;
                    is_active: root.is_favorite;
                    tooltip: "Favorite";
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle_favorite(); }
                }

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/share.svg");
                    icon_size: 14px;
                    btn_size: 30px;
                    tooltip: "Share";
                    y: (parent.height - self.height) / 2;
                }
            }

            // Center: Shuffle + Prev + White Circular Play/Pause + Next + Repeat + Timestamps
            HorizontalLayout {
                horizontal_stretch: 1;
                spacing: 12px;
                alignment: center;
                y: (parent.height - self.height) / 2;

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/shuffle.svg");
                    icon_size: 14px;
                    btn_size: 30px;
                    is_active: root.is_shuffle;
                    tooltip: "Shuffle";
                    clicked => { root.toggle_shuffle(); }
                }

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/prev.svg");
                    icon_size: 16px;
                    btn_size: 32px;
                    tooltip: "Previous";
                    clicked => { root.prev_track(); }
                }

                // Iconic White Circular Play/Pause Button (matching Image 2)
                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 19px;
                    background: #FFFFFF;
                    y: (parent.height - self.height) / 2;

                    TouchArea {
                        clicked => { root.toggle_play(); }
                    }

                    Image {
                        source: root.is_playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                        colorize: #000000;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/next.svg");
                    icon_size: 16px;
                    btn_size: 32px;
                    tooltip: "Next";
                    clicked => { root.next_track(); }
                }

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/repeat.svg");
                    icon_size: 14px;
                    btn_size: 30px;
                    is_active: root.is_repeat;
                    tooltip: "Repeat";
                    clicked => { root.toggle_repeat(); }
                }

                Text {
                    text: root.track_elapsed + " / " + root.track_duration;
                    font_size: 10px;
                    font_weight: 600;
                    color: Theme.text_muted;
                    vertical_alignment: center;
                }
            }

            // Right: Queue Toggle + Layout Switcher + Volume Slider + Percentage
            HorizontalLayout {
                width: 280px;
                spacing: 8px;
                alignment: end;
                y: (parent.height - self.height) / 2;

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/queue.svg");
                    icon_size: 15px;
                    btn_size: 30px;
                    is_active: root.show_queue;
                    tooltip: root.show_queue ? "Hide Queue" : "Show Queue";
                    clicked => { root.toggle_queue(); }
                }

                AuriIconButton {
                    icon_source: @image-url("../assets/icons/expand.svg");
                    icon_size: 14px;
                    btn_size: 30px;
                    tooltip: "Switch to Right Sidebar Player";
                    clicked => { root.toggle_player_layout(); }
                }

                AuriIconButton {
                    icon_source: root.volume == 0.0 ? @image-url("../assets/icons/volume-mute.svg") : @image-url("../assets/icons/volume.svg");
                    icon_size: 15px;
                    btn_size: 30px;
                    tooltip: root.volume == 0.0 ? "Unmute" : "Mute";
                    clicked => {
                        root.volume_changed(root.volume > 0.0 ? 0.0 : 0.8);
                    }
                }

                AuriSlider {
                    width: 88px;
                    height: 26px;
                    value: root.volume;
                    value_changed(val) => { root.volume_changed(val); }
                }

                Text {
                    text: Math.round(root.volume * 100) + "%";
                    font_size: 10px;
                    font_weight: 600;
                    color: Theme.text_muted;
                    width: 28px;
                    horizontal_alignment: right;
                    vertical_alignment: center;
                }
            }
        }
    }
}
}

